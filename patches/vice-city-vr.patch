+bool
+CdStreamAddImage(char const *path)
+{
+	return CdStreamAddImagePath(path, true);
+}
+
+bool
+CdStreamAddModelSetImages(char const *basePath)
+{
+	if(!CdStreamAddImagePath(basePath, true))
+		return false;
+	if(!ModelSets::IsModernActive())
+		return true;
+
+	char modernPath[1024];
+	if(!ModelSets::GetModernAssetPath("models\\gta3.img", modernPath,
+	   sizeof(modernPath)))
+		return true;
+	if(!CdStreamAddImagePath(modernPath, false)){
+		// The pair check at startup only looked at file attributes; an
+		// incomplete build or an antivirus still scanning the fresh 3.5GB
+		// archive passes that but fails to open. Play Classic this session
+		// instead of asserting; the request for the next launch is kept.
+		debug("Model set: failed to register Modern GTA3 overlay %s; "
+			"falling back to Classic for this session\n", modernPath);
+		ModelSets::DeactivateModernForSession();
+		return true;
+	}
+	if(ModelSets::GetActiveForCategory(
+	   ModelSets::MODEL_CATEGORY_VEGETATION) == ModelSets::MODEL_SET_MODERN){
+		char vegetationPath[1024];
+		if(ModelSets::GetOptimizedVegetationAssetPath("models\\gta3.img",
+		   vegetationPath, sizeof(vegetationPath)) &&
+		   !CdStreamAddImagePath(vegetationPath, false)){
+			debug("Model set: failed to register optimized vegetation overlay %s; using Modern fallback\n",
+				vegetationPath);
+			ModelSets::DeactivateOptimizedVegetationForSession();
+		}
+	}
+	if(ModelSets::GetActiveForCategory(
+	   ModelSets::MODEL_CATEGORY_VEHICLES) == ModelSets::MODEL_SET_XBOX){
+		char xboxPath[1024];
+		if(ModelSets::GetXboxAssetPath("models\\gta3.img", xboxPath,
+		   sizeof(xboxPath)) && !CdStreamAddImagePath(xboxPath, false)){
+			debug("Model set: failed to register Xbox vehicle overlay %s; using Classic vehicles\n",
+				xboxPath);
+			ModelSets::DeactivateXboxForSession();
+		}
+	}
+	debug("Model set: registered base and selected GTA3 overlays for category mixing\n");
+	return true;
+}
