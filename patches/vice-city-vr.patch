+	int32 handle;
+	int16 poolSlot;
+	int16 modelIndex;
+	int32 gridNext;
+	int32 cellX;
+	int32 cellY;
+	uint32 stateToken;
+	uint32 pedStateToken;
+	uint32 cruiseStateToken;
+	float positionX;
+	float positionY;
+	float positionZ;
+	float boundX;
+	float boundY;
+	float boundZ;
+	float forwardX;
+	float forwardY;
+	float forwardZ;
+	float rightX;
+	float rightY;
+	float rightZ;
+	float moveSpeedX;
+	float moveSpeedY;
+	float moveSpeedZ;
+	float width;
+	float frontLength;
+	float backLength;
+	float cruiseSpeed;
+	float cruiseCurrentLinkX;
+	float cruiseCurrentLinkY;
+	float cruiseCurrentForwardX;
+	float cruiseCurrentForwardY;
+	float cruiseNextLinkX;
+	float cruiseNextLinkY;
+	float cruiseNextForwardX;
+	float cruiseNextForwardY;
+	uint32 currentPathNodeInfo;
+	uint32 nextPathNodeInfo;
+	uint8 rawCruiseSpeed;
+	uint8 drivingStyle;
+	uint8 status;
+	uint8 carMission;
+	uint8 tempAction;
+	uint8 createdBy;
+	uint8 vehicleType;
+	bool usesCollision;
+	bool isPlayerVehicle;
+	bool isBike;
+	bool ignorePathfinding;
+	bool isLawEnforcer;
+	bool cruiseEligible;
+};
