+	case VR_LEGACY_RAINY_WEATHER: RainyWeatherCheat(); break;
+	case VR_LEGACY_FOGGY_WEATHER: FoggyWeatherCheat(); break;
+	case VR_LEGACY_FAST_WEATHER: FastWeatherCheat(); break;
+	case VR_LEGACY_FASTER_GAME: FastTimeCheat(); break;
+	case VR_LEGACY_SLOWER_GAME: SlowTimeCheat(); break;
+	case VR_LEGACY_WHEELS_ONLY: OnlyRenderWheelsCheat(); break;
+	case VR_LEGACY_FLYING_CARS: ChittyChittyBangBangCheat(); break;
+	case VR_LEGACY_CARS_DRIVE_ON_WATER: BackToTheFuture(); break;
+	case VR_LEGACY_FLYING_BOATS: FlyingFishCheat(); break;
+	case VR_LEGACY_STRONG_GRIP: StrongGripCheat(); break;
+	case VR_LEGACY_BIG_WHEELS: SpecialCarCheats(); break;
+	case VR_LEGACY_ALL_GREEN_LIGHTS: TrafficLightsCheat(); break;
+	case VR_LEGACY_AGGRESSIVE_TRAFFIC: MadCarsCheat(); break;
+	case VR_LEGACY_BLACK_CARS: BlackCarsCheat(); break;
+	case VR_LEGACY_PINK_CARS: PinkCarsCheat(); break;
+	case VR_LEGACY_SHOW_CHASE_STATS: DoShowChaseStatCheat(); break;
+	case VR_LEGACY_SMOKING_TOMMY: CSmokeTrails::CigOn = !CSmokeTrails::CigOn; break;
+	case VR_LEGACY_SUICIDE: SuicideCheat(); break;
+	default: return false;
+	}
+	return true;
+}
