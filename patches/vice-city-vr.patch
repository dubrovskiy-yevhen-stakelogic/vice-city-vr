+static void
+RenderVrTrackedForegroundCallback(void)
+{
+	// SubmitStereoFrame enters here after a custom temporal/fullscreen pipeline.
+	// Re-establish the normal RenderWare state contract before model and Im3D
+	// draws instead of inheriting descriptor/blend/depth state from that resolve.
+	DefinedState();
+	RenderVrTrackedHands();
+}
