+static void
+RotateVrVehicleCameraBasisToYaw(CVector &forward, CVector &up, float targetYaw)
+{
+	const float sourceYaw = atan2f(forward.y, forward.x);
+	float delta = targetYaw-sourceYaw;
+	while(delta >= PI) delta -= TWOPI;
+	while(delta < -PI) delta += TWOPI;
+	const float cosine = cosf(delta);
+	const float sine = sinf(delta);
+	const float forwardX = forward.x;
+	const float forwardY = forward.y;
+	const float upX = up.x;
+	const float upY = up.y;
+	forward.x = forwardX*cosine-forwardY*sine;
+	forward.y = forwardY*cosine+forwardX*sine;
+	up.x = upX*cosine-upY*sine;
+	up.y = upY*cosine+upX*sine;
+}
