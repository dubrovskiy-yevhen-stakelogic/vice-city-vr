+const char *GetVrMissionCategoryName(int category)
+{
+	switch(category){
+	case VR_MISSION_CATEGORY_STORY: return "STORY / CONTACT MISSIONS";
+	case VR_MISSION_CATEGORY_ASSETS: return "ASSETS / PROFESSIONS";
+	case VR_MISSION_CATEGORY_ACTIVITIES: return "SIDE ACTIVITIES";
+	default: return "UNKNOWN";
