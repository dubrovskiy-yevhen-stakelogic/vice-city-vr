+static void
+RenderVrCarSteeringWheel(void)
+{
+	if(!OculusVR::ShouldRenderImmersiveCarWheel())
+		return;
+	CVector center, wheelRight, wheelUp, normal;
+	float radius;
+#ifdef GTA_VR_OPENXR
+	// OpenXR owns one authoritative wheel pose. The rendered rim, automatic
+	// 9/3 grip anchors and interaction all consume the same centre and radius.
+	if(!OculusVR::GetImmersiveCarWheelPose(&center, &wheelRight,
+	   &wheelUp, &normal, &radius))
+		return;
+#else
+	// Preserve the legacy LibOVR backend until it adopts the versioned wheel
+	// pose. The release OpenXR path above never derives geometry from hand span.
+	CMatrix leftHandle, rightHandle;
+	if(!OculusVR::GetImmersiveSteeringHandleMatrix(0, &leftHandle) ||
+	   !OculusVR::GetImmersiveSteeringHandleMatrix(1, &rightHandle))
+		return;
+
+	normal = leftHandle.GetForward()+rightHandle.GetForward();
+	if(normal.MagnitudeSqr() < 0.0001f)
+		return;
+	normal.Normalise();
+	wheelRight =
+		rightHandle.GetPosition()-leftHandle.GetPosition();
+	wheelRight -= normal*DotProduct(wheelRight, normal);
+	const float gripSpan = wheelRight.Magnitude();
+	if(gripSpan < 0.10f)
+		return;
+	wheelRight *= 1.0f/gripSpan;
+	wheelUp = CrossProduct(wheelRight, normal);
+	if(wheelUp.MagnitudeSqr() < 0.0001f)
+		return;
+	wheelUp.Normalise();
+	// Classic Vice City and most replacement cars bake the cabin wheel into
+	// chassis_hi. A few Modern DFFs expose inconsistently named steering frames,
+	// but there is no safe shared atomic to animate. Draw a depth-tested,
+	// calibrated VR wheel from the same sockets as the hands instead.
+	radius = Max(0.12f, Min(gripSpan*0.5f, 0.32f));
+	center =
+		(leftHandle.GetPosition()+rightHandle.GetPosition())*0.5f-
+		normal*0.018f;
+#endif
+	enum { WHEEL_SEGMENTS = 24, WHEEL_BOXES = WHEEL_SEGMENTS+4 };
+	RwIm3DVertex vertices[WHEEL_BOXES*8];
+	RwImVertexIndex indices[WHEEL_BOXES*36];
+	int vertexCount = 0, indexCount = 0;
+	for(int segment = 0; segment < WHEEL_SEGMENTS; segment++){
+		const float angle0 = TWOPI*(float)segment/(float)WHEEL_SEGMENTS;
+		const float angle1 = TWOPI*(float)(segment+1)/(float)WHEEL_SEGMENTS;
+		const CVector start = center+
+			wheelRight*(cosf(angle0)*radius)+
+			wheelUp*(sinf(angle0)*radius);
+		const CVector end = center+
+			wheelRight*(cosf(angle1)*radius)+
+			wheelUp*(sinf(angle1)*radius);
+		CVector tangent = end-start;
+		const float length = tangent.Magnitude();
+		if(length < 0.001f)
+			continue;
+		tangent *= 1.0f/length;
+		CVector radial = (start+end)*0.5f-center;
+		radial.Normalise();
+		AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+			(start+end)*0.5f, tangent, radial, normal,
+			length*0.52f, 0.014f, 0.012f, 32, 34, 38);
+	}
+	for(int spoke = 0; spoke < 3; spoke++){
+		const float angle = TWOPI*(float)spoke/3.0f;
+		CVector direction =
+			wheelRight*cosf(angle)+wheelUp*sinf(angle);
+		direction.Normalise();
+		const float spokeLength = radius*0.72f;
+		CVector spokeSide = CrossProduct(normal, direction);
+		spokeSide.Normalise();
+		AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+			center+direction*(spokeLength*0.5f),
+			direction, spokeSide, normal,
+			spokeLength*0.5f, 0.012f, 0.010f, 46, 48, 53);
+	}
+	AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+		center, wheelRight, wheelUp, normal,
+		0.050f, 0.050f, 0.018f, 40, 42, 47);
+
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	if(GameRender::BeginImmediate3D(vertices, vertexCount, nil,
+	   rwIM3D_VERTEXXYZ|rwIM3D_VERTEXRGBA,
+	   GameRender::IMMEDIATE3D_DRAW_VR_HAND)){
+		GameRender::SubmitImmediate3DIndexed(rwPRIMTYPETRILIST,
+			indices, indexCount);
+		GameRender::EndImmediate3D();
+	}
+}
+
+static void
+RenderVrSteeringHandleMarkers(void)
+{
+	RwIm3DVertex vertices[16];
+	RwImVertexIndex indices[72];
+	int vertexCount = 0, indexCount = 0;
+	for(int hand = 0; hand < 2; hand++){
+		if(!OculusVR::ShouldRenderImmersiveSteeringHandleMarker(hand))
+			continue;
+		CMatrix matrix;
+		if(!OculusVR::GetImmersiveSteeringHandleMatrix(hand, &matrix))
+			continue;
+		const bool grabbed =
+			OculusVR::IsImmersiveSteeringHandleGrabbed(hand);
+		AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+			matrix.GetPosition(), matrix.GetRight(), matrix.GetUp(),
+			matrix.GetForward(), 0.035f, 0.035f, 0.055f,
+			grabbed ? 70 : 35, grabbed ? 245 : 180,
+			grabbed ? 125 : 245);
+	}
+	if(vertexCount == 0)
+		return;
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	if(GameRender::BeginImmediate3D(vertices, vertexCount, nil,
+	   rwIM3D_VERTEXXYZ|rwIM3D_VERTEXRGBA,
+	   GameRender::IMMEDIATE3D_DRAW_VR_HAND)){
+		GameRender::SubmitImmediate3DIndexed(rwPRIMTYPETRILIST,
+			indices, indexCount);
+		GameRender::EndImmediate3D();
+	}
+}
+
+static void
+RenderVrTrackedHands(void)
+{
+	// A physical optic is already represented by the dedicated OpenXR scope
+	// overlay.  Keeping either glove or the weapon model in this pass puts them
+	// in front of that optical image, so suppress all tracked-hand geometry while
+	// the optic is at the eye.  The scope mask/reticle is rendered independently
+	// by RenderVrGameplayHud and therefore remains visible.
+	if(OculusVR::IsTrackedScopeActive())
+		return;
+	// Teleport is a locomotion aid rather than a hand feature, so keep its
+	// trajectory visible even when the optional hand models are disabled.
+	RenderVrTeleportTrajectory();
+	if(CCutsceneMgr::IsRunning() || CCutsceneMgr::IsCutsceneProcessing() ||
+	   TheCamera.m_WideScreenOn ||
+	   CWorld::Players[CWorld::PlayerInFocus].IsPlayerInRemoteMode() ||
+	   (FindPlayerVehicle() &&
+	    !OculusVR::IsImmersiveDrivingActive()))
+		return;
+	CPed *player = FindPlayerPed();
+	if(!player || !player->m_rwObject || player->DyingOrDead())
+		return;
+	if(!OculusVR::AreTrackedHandsEnabled()){
+		// The physical steering aid and its calibration markers are vehicle
+		// controls, not hand-model cosmetics. Keep them available when the player
+		// deliberately hides the rendered VR hands.
+		RenderVrCarSteeringWheel();
+		RenderVrSteeringHandleMarkers();
+		return;
+	}
+	RenderVrTrackedWeapon(player, 0);
+	RenderVrTrackedWeapon(player, 1);
+	RenderVrWeaponLaser(player, 0);
+	RenderVrWeaponLaser(player, 1);
+	RenderVrThrowableTrajectory(player, 0);
+	RenderVrThrowableTrajectory(player, 1);
+	RenderVrWeaponHolsters(player);
+	RenderVrReloadMagazine();
+	RenderVrCarSteeringWheel();
+	RenderVrSteeringHandleMarkers();
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	RenderVrTrackedHand(0);
+	RenderVrTrackedHand(1);
+}
