+struct VrHolsterWeaponCache
+{
+	int modelId;
+	RpAtomic *atomic;
+	VrHolsterWeaponCache() : modelId(-1), atomic(nil) {}
+};
+
+static VrHolsterWeaponCache gVrHolsterWeaponCache[TOTAL_WEAPON_SLOTS];
+
+static void
+ReleaseVrHolsterWeapon(VrHolsterWeaponCache &cache)
+{
+	if(!cache.atomic)
+		return;
+	CBaseModelInfo *modelInfo = CVisibilityPlugins::GetAtomicModelInfo(cache.atomic);
+	if(modelInfo)
+		modelInfo->RemoveRef();
+	RwFrame *frame = RpAtomicGetFrame(cache.atomic);
+	RpAtomicDestroy(cache.atomic);
+	if(frame)
+		RwFrameDestroy(frame);
+	cache.atomic = nil;
+	cache.modelId = -1;
+}
+
+static RpAtomic*
+GetVrHolsterWeaponAtomic(int slot, int modelId)
+{
+	if(slot < 0 || slot >= TOTAL_WEAPON_SLOTS || modelId < 0)
+		return nil;
+	VrHolsterWeaponCache &cache = gVrHolsterWeaponCache[slot];
+	if(cache.modelId != modelId)
+		ReleaseVrHolsterWeapon(cache);
+	if(!cache.atomic){
+		if(!CStreaming::HasModelLoaded(modelId))
+			return nil;
+		CBaseModelInfo *modelInfo = CModelInfo::GetModelInfo(modelId);
+		if(!modelInfo)
+			return nil;
+		// CreateInstance returns an atomic only for the simple model types
+		// weapons normally use. A replacement model declared as a clump returns
+		// an RpClump instead, and the blind cast below then handed a clump to
+		// RpAtomicGetFrame. Leave the weapon unrendered rather than follow a
+		// pointer into the wrong object.
+		const uint8 modelType = modelInfo->GetModelType();
+		if(modelType != MITYPE_SIMPLE && modelType != MITYPE_TIME &&
+		   modelType != MITYPE_WEAPON)
+			return nil;
+		cache.atomic = (RpAtomic*)modelInfo->CreateInstance();
+		if(!cache.atomic)
+			return nil;
+		modelInfo->AddRef();
+		cache.modelId = modelId;
+	}
+	return cache.atomic;
+}
+
+void
+ReleaseVrGameResources(void)
+{
+	// This runs before CModelInfo::ShutDown. Releasing the calibration snapshot
+	// or a cached atomic later would call RemoveRef with m_txdSlot == -1 and
+	// assert in CTxdStore::GetSlot.
+	OculusVR::PrepareForGameShutdown();
+	for(int slot = 0; slot < TOTAL_WEAPON_SLOTS; slot++)
+		ReleaseVrHolsterWeapon(gVrHolsterWeaponCache[slot]);
+	VRHandModel::Shutdown();
+}
+
+static void
+RenderVrWeaponHolsters(CPed *player)
+{
+	if(!player)
+		return;
+	RwIm3DVertex markers[TOTAL_WEAPON_SLOTS*8];
+	RwImVertexIndex markerIndices[TOTAL_WEAPON_SLOTS*36];
+	int markerVertexCount = 0, markerIndexCount = 0;
+	for(int slot = WEAPONSLOT_MELEE; slot < TOTAL_WEAPON_SLOTS; slot++){
+		CMatrix placement;
+		const bool inHolster = OculusVR::GetWeaponHolsterMatrix(slot, &placement);
+		const bool dropped = !inHolster &&
+			OculusVR::GetDroppedWeaponMatrix(slot, &placement);
+		if(!inHolster && !dropped)
+			continue;
+		CWeapon *weapon = &player->GetWeapon(slot);
+		// GetWeaponHolsterMatrix only reports which holsters the player enabled,
+		// not whether anything is in them. An empty slot still holds
+		// WEAPONTYPE_UNARMED, which was carried on into model lookup and drawing.
+		if(weapon->m_eWeaponType == WEAPONTYPE_UNARMED)
+			continue;
+		CWeaponInfo *weaponInfo = CWeaponInfo::GetWeaponInfo(weapon->m_eWeaponType);
+		if(!weaponInfo)
+			continue;
+		if(inHolster && OculusVR::AreWeaponHolsterHighlightsEnabled())
+			AppendVrHandBox(markers, markerVertexCount, markerIndices, markerIndexCount,
+				placement.GetPosition(), placement.GetRight(), placement.GetUp(), placement.GetForward(),
+				0.026f, 0.026f, 0.026f, 30, 205, 245);
+		RpAtomic *atomic = GetVrHolsterWeaponAtomic(slot, weaponInfo->m_nModelId);
+		if(!atomic)
+			continue;
+		CMatrix modelMatrix = placement;
+		CMatrix authoredWeaponAdjustment;
+		// Firearms and the chainsaw are authored lengthwise on local +X, while
+		// clubs/blades and all throwable DFFs use local +Z. Convert that +Z axis to
+		// vertical-down only while the model is on the body; dropped matrices
+		// preserve the exact calibrated in-hand pose and must not be reinterpreted.
+		if(inHolster &&
+		   ((OculusVR::IsPhysicalMeleeType(weapon->m_eWeaponType) &&
+		     weapon->m_eWeaponType != WEAPONTYPE_CHAINSAW) ||
+		    OculusVR::IsPhysicalThrowableType(weapon->m_eWeaponType)))
+			authoredWeaponAdjustment.SetRotateX(DEGTORAD(90.0f));
+		else
+			authoredWeaponAdjustment.SetRotate(DEGTORAD(90.0f), 0.0f,
+				DEGTORAD(-90.0f));
+		modelMatrix = modelMatrix*authoredWeaponAdjustment;
+		RwFrame *frame = RpAtomicGetFrame(atomic);
+		if(!frame)
+			continue;
+		modelMatrix.CopyToRwMatrix(RwFrameGetMatrix(frame));
+		RwFrameUpdateObjects(frame);
+		RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+		RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+		RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+		// A dropped weapon keeps the calibrated in-hand placement, so it also
+		// keeps that hand's mirroring; holstered matrices come from the body
+		// and stay unmirrored, leaving this a no-op for them.
+		RwRenderStateSet(rwRENDERSTATECULLMODE,
+			(void*)GetVrWeaponCullMode(modelMatrix));
+		GameRender::SubmitAtomic(atomic, GameRender::OBJECT_DRAW_VR_WEAPON);
+		RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLBACK);
+	}
+	if(markerVertexCount > 0){
+		RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+		RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+		RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+		RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)FALSE);
+		RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+		RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+		if(GameRender::BeginImmediate3D(markers, markerVertexCount, nil,
+			rwIM3D_VERTEXXYZ|rwIM3D_VERTEXRGBA, GameRender::IMMEDIATE3D_DRAW_VR_HAND)){
+			GameRender::SubmitImmediate3DIndexed(rwPRIMTYPETRILIST,
+				markerIndices, markerIndexCount);
+			GameRender::EndImmediate3D();
+		}
+	}
+}
