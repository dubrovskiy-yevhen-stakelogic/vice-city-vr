+static bool
+UnlockVrSixStarWantedCap(void)
+{
+	// This unlocks progression's cap only.  It deliberately does not call
+	// CheatWantedLevel, so the player's current wanted level is unchanged.
+	CWanted::SetMaximumWantedLevel(6);
+	return CWanted::MaximumWantedLevel == 6;
+}
+
+static bool
+IsVrCycleCarModel(int model)
+{
+	switch(model){
+	case MI_RCBANDIT:
+	case MI_HUNTER:
+	case MI_CHOPPER:
+	case MI_SEASPAR:
+	case MI_AIRTRAIN:
+	case MI_DEADDODO:
+	case MI_SKIMMER:
+	case MI_RCBARON:
+	case MI_RCRAIDER:
+	case MI_SPARROW:
+	case MI_MAVERICK:
+	case MI_VCNMAV:
+	case MI_POLMAV:
+	case MI_RCGOBLIN:
+		return false;
+	default:
+		break;
+	}
+	CBaseModelInfo *base = CModelInfo::GetModelInfo(model);
+	if(!base)
+		return false;
+	CVehicleModelInfo *vehicle = (CVehicleModelInfo*)base;
+	return vehicle->m_vehicleType == VEHICLE_TYPE_CAR;
+}
+
+static int
+FindVrCycleCarModel(int start, int direction)
+{
+	const int count = MI_LAST_VEHICLE-MI_FIRST_VEHICLE+1;
+	direction = direction < 0 ? -1 : 1;
+	int model = start;
+	while(model < MI_FIRST_VEHICLE)
+		model += count;
+	while(model > MI_LAST_VEHICLE)
+		model -= count;
+	for(int checked = 0; checked < count; checked++){
+		if(IsVrCycleCarModel(model))
+			return model;
+		model += direction;
+		if(model > MI_LAST_VEHICLE)
+			model = MI_FIRST_VEHICLE;
+		else if(model < MI_FIRST_VEHICLE)
+			model = MI_LAST_VEHICLE;
+	}
+	return -1;
+}
+
+static void
+CycleVrModelIndex(int &index, int count, int direction)
+{
+	if(count <= 0 || direction == 0)
+		return;
+	index = (index+count+(direction > 0 ? 1 : -1)) % count;
+}
+
+const char *
+GetVrVehicleModelName(int model)
+{
+	CBaseModelInfo *modelInfo =
+		model >= MI_FIRST_VEHICLE && model <= MI_LAST_VEHICLE ?
+		CModelInfo::GetModelInfo(model) : nil;
+	return modelInfo && modelInfo->GetModelName() ?
+		modelInfo->GetModelName() : "UNKNOWN";
+}
+
+bool CycleVrCheatSelection(int index, int direction)
+{
+	if(direction == 0)
+		return false;
+	if(index == VR_SPECIAL_SPAWN_NEXT_CAR){
+		const int current = FindVrCycleCarModel(gVrCycleCarCursor, 1);
+		if(current < 0)
+			return false;
+		gVrCycleCarCursor = FindVrCycleCarModel(
+			current+(direction > 0 ? 1 : -1), direction);
+		return gVrCycleCarCursor >= 0;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_MOTORCYCLE){
+		CycleVrModelIndex(gVrCycleBikeIndex,
+			ARRAY_SIZE(gVrCycleBikeModels), direction);
+		return true;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_HELICOPTER){
+		CycleVrModelIndex(gVrCycleHelicopterIndex,
+			ARRAY_SIZE(gVrCycleHelicopterModels), direction);
+		return true;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_AIRPLANE){
+		CycleVrModelIndex(gVrCycleAirplaneIndex,
+			ARRAY_SIZE(gVrCycleAirplaneModels), direction);
+		return true;
+	}
+	return false;
+}
