+#if defined(RW_D3D12) && defined(GTA_VR_OPENXR)
+static bool
+ShouldRenderVrTrackedForeground(void)
+{
+	if(OculusVR::IsTrackedScopeActive())
+		return false;
+	// RenderVrTrackedHands draws teleport before all gameplay/player guards.
+	// Preserve that ordering in the cheap eligibility test.
+	CVector teleportPoints[2];
+	int teleportPointCount = 0;
+	if(OculusVR::GetTeleportTrajectory(teleportPoints,
+	   ARRAY_SIZE(teleportPoints), &teleportPointCount) &&
+	   teleportPointCount >= 2)
+		return true;
+	if(CCutsceneMgr::IsRunning() || CCutsceneMgr::IsCutsceneProcessing() ||
+	   TheCamera.m_WideScreenOn ||
+	   CWorld::Players[CWorld::PlayerInFocus].IsPlayerInRemoteMode() ||
+	   (FindPlayerVehicle() && !OculusVR::IsImmersiveDrivingActive()))
+		return false;
+	CPed *player = FindPlayerPed();
+	if(!player || !player->m_rwObject || player->DyingOrDead())
+		return false;
+	if(OculusVR::AreTrackedHandsEnabled())
+		return true;
+	return OculusVR::ShouldRenderImmersiveCarWheel() ||
+		OculusVR::ShouldRenderImmersiveSteeringHandleMarker(0) ||
+		OculusVR::ShouldRenderImmersiveSteeringHandleMarker(1);
+}
