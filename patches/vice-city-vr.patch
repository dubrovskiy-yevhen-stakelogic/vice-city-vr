+static void
+PrepareVrStereoWorldReplay(void)
+{
+	// Fading geometry is alpha-heavy.  Replaying its immutable left-eye packet
+	// with the right-eye matrices avoids rebuilding the legacy entity lists,
+	// while retaining the more efficient narrow per-eye rasterization path.
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLBACK);
+}
+
+static bool
+BeginVrEyePassD3D12(int eye, float originalFov, bool clearAndPrepare)
+{
+	OculusVR::PerfBeginPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+	CMatrix eyeCamera;
+	float eyeFov = originalFov;
+	if(!OculusVR::BeginEye(Scene.camera, eye, &eyeCamera, &eyeFov)){
+		OculusVR::PerfEndPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+		return false;
+	}
+	TheCamera.GetMatrix() = eyeCamera;
+	CDraw::SetFOV(eyeFov);
+	TheCamera.CalculateDerivedValues();
+	CVisibilityPlugins::SetRenderWareCamera(Scene.camera);
+	if(clearAndPrepare)
+		RwCameraClear(Scene.camera, &gColourTop, CLEARMODE | rwCAMERACLEARIMAGE);
+	if(!RwCameraBeginUpdate(Scene.camera)){
+		OculusVR::PerfEndPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+		return false;
+	}
+	float jitterClipX = 0.0f, jitterClipY = 0.0f;
+	OculusVR::GetTemporalJitterClip(&jitterClipX, &jitterClipY);
+	rw::d3d12::captureStereoWorldCamera(eye, jitterClipX, jitterClipY);
+	TheCamera.m_viewMatrix.Update();
+	CRenderer::PrepareVrOcclusionForCurrentView(eye);
+	if(clearAndPrepare){
+		if(CWeather::LightningFlash && !CCullZones::CamNoRain())
+			CClouds::RenderBackground(255, 255, 255, 255, 255, 255, 255);
+		else
+			CClouds::RenderBackground(CTimeCycle::GetSkyTopRed(), CTimeCycle::GetSkyTopGreen(),
+				CTimeCycle::GetSkyTopBlue(), CTimeCycle::GetSkyBottomRed(),
+				CTimeCycle::GetSkyBottomGreen(), CTimeCycle::GetSkyBottomBlue(), 255);
+	}
+	DefinedState();
+	return true;
+}
+
+static void
+EndVrEyePassD3D12(int eye)
+{
+	RwCameraEndUpdate(Scene.camera);
+	OculusVR::PerfEndPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+}
+
+enum eVrSinglePassWorldStage {
+	VR_SINGLE_PASS_ROADS,
+	VR_SINGLE_PASS_ENTITIES,
+	VR_SINGLE_PASS_BOATS,
+	VR_SINGLE_PASS_FADING_UNDERWATER,
+	VR_SINGLE_PASS_FADING
+};
+
+static void
+RenderVrSinglePassWorldStageContentsD3D12(eVrSinglePassWorldStage stage)
+{
+	switch(stage){
+	case VR_SINGLE_PASS_ROADS:
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_ROADS);
+		CRenderer::RenderRoads();
+		break;
+	case VR_SINGLE_PASS_ENTITIES:
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_ENTITIES);
+		CRenderer::RenderEverythingBarRoads();
+		break;
+	case VR_SINGLE_PASS_BOATS:
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_BOATS);
+		CRenderer::RenderBoats();
+		break;
+	case VR_SINGLE_PASS_FADING_UNDERWATER:
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_FADING);
+		RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)TRUE);
+		RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+		RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLBACK);
+		CRenderer::RenderFadingInUnderwaterEntities();
+		break;
+	case VR_SINGLE_PASS_FADING:
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_FADING);
+		CRenderer::RenderFadingInEntities();
+		break;
+	}
+}
+
+static bool
+RenderVrSinglePassWorldStageD3D12(eVrSinglePassWorldStage stage, float originalFov)
+{
+	if(!BeginVrEyePassD3D12(0, originalFov, false))
+		return false;
+	const bool singlePass = rw::d3d12::beginStereoSinglePass() != 0;
+	RenderVrSinglePassWorldStageContentsD3D12(stage);
+	if(singlePass)
+		rw::d3d12::endStereoSinglePass();
+	EndVrEyePassD3D12(0);
+
+	// A resource or capability failure keeps a fully functional two-pass
+	// fallback instead of leaving the right half incomplete.
+	if(!singlePass){
+		if(!BeginVrEyePassD3D12(1, originalFov, false))
+			return false;
+		RenderVrSinglePassWorldStageContentsD3D12(stage);
+		EndVrEyePassD3D12(1);
+	}
+	return true;
+}
+
+static bool
+RenderVrStereoFadingStageD3D12(bool underwater, float originalFov)
+{
+	const uint32 segment = underwater ?
+		rw::d3d12::STEREO_WORLD_FADING_UNDERWATER :
+		rw::d3d12::STEREO_WORLD_FADING;
+	for(int eye = 0; eye < 2; eye++){
+		if(!BeginVrEyePassD3D12(eye, originalFov, false))
+			return false;
+		PrepareVrStereoWorldReplay();
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_FADING);
+		if(eye == 0){
+			rw::d3d12::beginStereoWorldCapture(segment);
+			if(underwater)
+				CRenderer::RenderFadingInUnderwaterEntities();
+			else
+				CRenderer::RenderFadingInEntities();
+			rw::d3d12::endStereoWorldCapture(segment);
+		}else if(!rw::d3d12::replayStereoWorldSegment(segment)){
+			if(underwater)
+				CRenderer::RenderFadingInUnderwaterEntities();
+			else
+				CRenderer::RenderFadingInEntities();
+		}
+		EndVrEyePassD3D12(eye);
+	}
+	return true;
+}
+
+static bool
+RenderVrStereoFrameD3D12(float originalFov)
+{
+	rw::d3d12::beginStereoWorldFrame();
+	// Establish both sky/depth halves before a wide draw can touch them.
+	rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_SKY);
+	for(int eye = 0; eye < 2; eye++){
+		if(!BeginVrEyePassD3D12(eye, originalFov, true))
+			return false;
+		CClouds::Render();
+		DoRWRenderHorizon();
+		EndVrEyePassD3D12(eye);
+	}
+
+	if(!RenderVrSinglePassWorldStageD3D12(VR_SINGLE_PASS_ROADS, originalFov))
+		return false;
+	for(int eye = 0; eye < 2; eye++){
+		if(!BeginVrEyePassD3D12(eye, originalFov, false))
+			return false;
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_CORONA_REFLECTIONS);
+		CCoronas::RenderReflections();
+		EndVrEyePassD3D12(eye);
+	}
+	if(!RenderVrSinglePassWorldStageD3D12(VR_SINGLE_PASS_ENTITIES, originalFov))
+		return false;
+
+	// Water remains per-eye because the legacy immediate-mode path uses the
+	// active eye viewport. Boats use instanced stereo. Alpha-heavy fading can be
+	// compared live between full SPS and narrow packet replay.
+	for(int eye = 0; eye < 2; eye++){
+		if(!BeginVrEyePassD3D12(eye, originalFov, false))
+			return false;
+		RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_WATER);
+		CWaterLevel::RenderWater();
+		EndVrEyePassD3D12(eye);
+	}
+	if(!RenderVrSinglePassWorldStageD3D12(VR_SINGLE_PASS_BOATS, originalFov))
+		return false;
+	if(OculusVR::UseFullStereoSinglePass()){
+		if(!RenderVrSinglePassWorldStageD3D12(VR_SINGLE_PASS_FADING_UNDERWATER, originalFov))
+			return false;
+	}else if(!RenderVrStereoFadingStageD3D12(true, originalFov))
+		return false;
+	for(int eye = 0; eye < 2; eye++){
+		if(!BeginVrEyePassD3D12(eye, originalFov, false))
+			return false;
+		RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_TRANSPARENT_WATER);
+		CWaterLevel::RenderTransparentWater();
+		EndVrEyePassD3D12(eye);
+	}
+	if(OculusVR::UseFullStereoSinglePass()){
+		if(!RenderVrSinglePassWorldStageD3D12(VR_SINGLE_PASS_FADING, originalFov))
+			return false;
+	}else if(!RenderVrStereoFadingStageD3D12(false, originalFov))
+		return false;
+
+	// Rain, coronas and transient immediate-mode effects keep their proven
+	// per-eye submission order.
+	for(int eye = 0; eye < 2; eye++){
+		if(!BeginVrEyePassD3D12(eye, originalFov, false))
+			return false;
+		RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_EFFECTS);
+		CWeather::RenderRainStreaks();
+		CCoronas::RenderSunReflection();
+		C3dMarkers::SetPreserveAfterRender(eye == 0);
+		CShadows::SetPreserveAfterRender(eye == 0);
+		CBrightLights::SetPreserveAfterRender(eye == 0);
+		CShinyTexts::SetPreserveAfterRender(eye == 0);
+		RenderEffects();
+		// The post-temporal hand path is optional. If its PSO or render plumbing is
+		// unavailable, retain the proven world-pass behavior rather than hiding the
+		// controls or failing the OpenXR session.
+		if(!OculusVR::IsTrackedForegroundRenderAvailable()){
+			rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_FX_HANDS);
+			RenderVrTrackedHands();
+		}
+		rw::d3d12::setWorldRenderStage(rw::d3d12::WORLD_STAGE_OTHER);
+		EndVrEyePassD3D12(eye);
+	}
+	return true;
+}
