+void
+CRenderer::PrepareVrOcclusionForCurrentView(int eye)
+{
+	// ConstructRenderList builds the legacy screen-space occluder silhouettes
+	// before the tracked OpenXR camera is active. Capture an independent active
+	// set from each real eye. Single-pass stereo can then discard a building only
+	// when both eyes agree that it is hidden.
+	if(!ms_bVrOcclusionCulling || eye < 0 || eye >= 2)
+		return;
+	const uint32 frame = CTimer::GetFrameCounter();
+	if(gVrOcclusionPreparedFrame != frame){
+		gVrOcclusionPreparedFrame = frame;
+		gVrOcclusionPreparedMask = 0;
+	}
+	gVrOcclusionCurrentEye = (int8)eye;
+	const uint8 eyeBit = (uint8)(1U << eye);
+	if((gVrOcclusionPreparedMask & eyeBit) != 0){
+		// Legacy water and other non-entity tests still consume the global active
+		// array, so restore the matching eye even after its context was captured.
+		COcclusion::ApplyContext(gVrOcclusionContext[eye]);
+		return;
+	}
+	COcclusion::ProcessBeforeRendering();
+	COcclusion::CaptureContext(&gVrOcclusionContext[eye]);
+	gVrOcclusionPreparedMask |= eyeBit;
+}
+
+int
+CRenderer::GetVrOcclusionActiveCount(int eye)
+{
+	if(eye < 0 || eye >= 2 ||
+	   gVrOcclusionPreparedFrame != CTimer::GetFrameCounter() ||
+	   (gVrOcclusionPreparedMask & (1U << eye)) == 0)
+		return 0;
+	return gVrOcclusionContext[eye].numActiveOccluders;
+}
