+static std::atomic<uint32> gVrTrafficJobEpoch(1);
+
+static uint32
+VrTrafficHashBits(uint32 hash, uint32 value)
+{
+	return (hash ^ value)*16777619u;
+}
+
+static uint32
+VrTrafficHashFloat(uint32 hash, float value)
+{
+	uint32 bits;
+	memcpy(&bits, &value, sizeof(bits));
+	return VrTrafficHashBits(hash, bits);
+}
+
+static int32
+VrTrafficGridCell(float value)
+{
+	return (int32)floorf(value/VR_TRAFFIC_GRID_CELL_SIZE);
+}
+
+static int32
+VrTrafficGridHash(int32 x, int32 y)
+{
+	const uint32 hash = (uint32)x*73856093u ^ (uint32)y*19349663u;
+	return (int32)(hash & (VR_TRAFFIC_GRID_BUCKETS-1));
+}
