+	if(CPools::GetObjectPool() == nil || ThePaths.m_numCarPathNodes <= 0)
+		return false;
+
+	int removedBarriers = 0;
+	// The scripts close the hurricane bridges in two parts: mission objects
+	// form the visible barricades and the matching car-path nodes are disabled.
+	// Find the objects while those nodes are still closed.  A map-disabled node
+	// is never a story closure, and pickup objects must retain their pool slots.
+	for(int i = CPools::GetObjectPool()->GetSize()-1; i >= 0; i--){
+		CObject *object = CPools::GetObjectPool()->GetSlot(i);
+		if(object == nil || object->ObjectCreatedBy != MISSION_OBJECT ||
+		   object->bIsPickup)
+			continue;
+
+		const CVector position = object->GetPosition();
+		bool onRuntimeDisabledCarPath = false;
+		for(int n = 0; n < ThePaths.m_numCarPathNodes; n++){
+			if(!ThePaths.m_pathNodes[n].bDisabled ||
+			   ThePaths.WasDisabledByMap(n))
+				continue;
+			const CVector node = ThePaths.m_pathNodes[n].GetPosition();
+			if(Abs(node.z-position.z) < 5.0f &&
+			   (CVector2D(node.x, node.y)-
+			    CVector2D(position.x, position.y)).MagnitudeSqr() <
+				12.0f*12.0f){
+				onRuntimeDisabledCarPath = true;
+				break;
+			}
+		}
+		if(!onRuntimeDisabledCarPath)
+			continue;
+
+		// Do not delete the object: scripts may still own its handle.  Moving it
+		// below the world removes the physical obstruction without dangling any
+		// script or pool references.
+		CWorld::Remove(object);
+		object->SetPosition(CVector(position.x, position.y,
+			position.z-500.0f));
+		object->GetMatrix().UpdateRW();
+		object->UpdateRwFrame();
+		CWorld::Add(object);
+		removedBarriers++;
+	}
+
+	int reopenedRoads = 0;
+	for(int n = 0; n < ThePaths.m_numCarPathNodes; n++){
+		if(ThePaths.m_pathNodes[n].bDisabled &&
+		   !ThePaths.WasDisabledByMap(n)){
+			ThePaths.m_pathNodes[n].bDisabled = false;
+			reopenedRoads++;
+		}
+	}
+	return removedBarriers != 0 || reopenedRoads != 0;
+#else
+	return false;
+#endif
+}
