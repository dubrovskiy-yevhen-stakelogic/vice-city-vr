+static bool
+IsVrKatanaHeadStrike(CEntity *target, float strikeSpeed,
+	const CVector &rootStart, const CVector &rootEnd,
+	const CVector &tipStart, const CVector &tipEnd)
+{
+	if(!target || !target->IsPed() || strikeSpeed < 0.70f)
+		return false;
+	CPed *victim = (CPed*)target;
+	if(victim->IsPlayer() || victim->DyingOrDead() ||
+	   victim->bBodyPartJustCameOff || victim->bNoCriticalHits ||
+	   !victim->GetClump() || !victim->m_pFrames[PED_HEAD] ||
+	   !victim->m_pFrames[PED_NECK])
+		return false;
+	// Culled/distant peds can otherwise retain bone matrices from an older
+	// animation frame. Synchronise the hierarchy before the physical blade test.
+	victim->UpdateRpHAnim();
+
+	// The broad ped collision used by physical melee normally reports the torso,
+	// even when the visible blade crosses the face. Build a capsule between the
+	// animated neck and head, then test both the blade at several instants and
+	// the trajectories of points along it. Exclude the lower handle so a hand near
+	// somebody's face cannot count as a blade hit.
+	const CVector head = victim->GetNodePosition(PED_HEAD)+
+		CVector(0.0f, 0.0f, 0.05f);
+	const CVector neck = victim->GetNodePosition(PED_NECK);
+	CVector headAxis = head-neck;
+	if(headAxis.MagnitudeSqr() > 0.000001f)
+		headAxis.Normalise();
+	else
+		headAxis = CVector(0.0f, 0.0f, 1.0f);
+	const CVector capsuleEnd = head+headAxis*0.10f;
+	float closestSqr = 1000000.0f;
+	for(int sample = 0; sample <= 6; sample++){
+		const float t = (float)sample/6.0f;
+		const CVector root = rootStart+(rootEnd-rootStart)*t;
+		const CVector tip = tipStart+(tipEnd-tipStart)*t;
+		const CVector bladeStart = root+(tip-root)*0.04f;
+		closestSqr = Min(closestSqr, VrDistanceBetweenSegmentsSqr(
+			bladeStart, tip, neck, capsuleEnd));
+	}
+	for(int sample = 0; sample <= 6; sample++){
+		const float along = 0.04f+0.96f*(float)sample/6.0f;
+		const CVector previousPoint = rootStart+(tipStart-rootStart)*along;
+		const CVector currentPoint = rootEnd+(tipEnd-rootEnd)*along;
+		closestSqr = Min(closestSqr, VrDistanceBetweenSegmentsSqr(
+			previousPoint, currentPoint, neck, capsuleEnd));
+	}
+	return closestSqr <= SQR(0.19f);
+}
+
+static CPed*
+FindVrKatanaHeadTarget(CPlayerPed *player, float strikeSpeed,
+	const CVector &rootStart, const CVector &rootEnd,
+	const CVector &tipStart, const CVector &tipEnd, CVector *impact,
+	CPed *preferredTarget = nil)
+{
+	if(!player || !impact)
+		return nil;
+	CPed *best = nil;
+	float bestDistanceSqr = 1000000.0f;
+	CEntity *savedIgnoreEntity = CWorld::pIgnoreEntity;
+	CWorld::pIgnoreEntity = player;
+	// Test the exact pending physical target first.  This matters immediately
+	// after a hospital teleport, before Vice City's 16-frame near-ped list catches
+	// up, and also avoids losing a head upgrade at the edge of that list.
+	for(int index = -1; index < player->m_numNearPeds; index++){
+		CPed *candidate = index < 0 ? preferredTarget : player->m_nearPeds[index];
+		if(index >= 0 && candidate == preferredTarget)
+			continue;
+		if(!candidate || !IsVrKatanaHeadStrike(candidate, strikeSpeed,
+		   rootStart, rootEnd, tipStart, tipEnd))
+			continue;
+		const CVector head = candidate->GetNodePosition(PED_HEAD)+
+			CVector(0.0f, 0.0f, 0.05f);
+		CColPoint visibilityPoint;
+		CEntity *first = nil;
+		const bool visibilityHit = CWorld::ProcessLineOfSight(rootEnd, head,
+			visibilityPoint, first, true, true, true, true, true,
+			false, false, false);
+		if(visibilityHit && first != candidate)
+			continue;
+		const float distanceSqr = (head-rootEnd).MagnitudeSqr();
+		if(distanceSqr < bestDistanceSqr){
+			best = candidate;
+			bestDistanceSqr = distanceSqr;
+			*impact = head;
+		}
+	}
+	CWorld::pIgnoreEntity = savedIgnoreEntity;
+	return best;
+}
