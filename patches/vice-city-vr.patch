+	// Match ProcessAnimGroups' backward sector. The authored walk_start_back is
+	// a 0.2 s transition, and the normal state machine holds the repeating clips
+	// until it finishes; in VR that startup feels as though input was ignored.
+	const float inputAngle = CGeneral::LimitRadianAngle(
+		CGeneral::GetRadianAngleBetweenPoints(
+			0.0f, 0.0f, -leftRight, upDown));
+	return Abs(inputAngle) > DEGTORAD(130.0f);
