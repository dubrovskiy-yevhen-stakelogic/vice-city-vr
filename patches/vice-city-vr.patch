+int GetVrMissionCount(int category)
+{
+	int count = 0;
+	GetVrMissionCategoryEntries(category, &count);
+	return count;
+}
+
+const char *GetVrMissionName(int category, int item)
+{
+	static char label[112];
+	int count = 0;
+	const uint8 *entries = GetVrMissionCategoryEntries(category, &count);
+	if(!entries || item < 0 || item >= count)
+		return "UNKNOWN";
+	const int mission = entries[item];
+	sprintf(label, "%02d  %s", mission, gVrMissionNames[mission]);
+	return label;
+}
+
+bool ActivateVrMission(int category, int item)
+{
+	int count = 0;
+	const uint8 *entries = GetVrMissionCategoryEntries(category, &count);
+	if(!FindPlayerPed() || !entries || item < 0 || item >= count)
+		return false;
+#ifdef MISSION_SWITCHER
+	if(!CTheScripts::TrySwitchToMission(entries[item]))
+		return false;
+	CPad::bHasPlayerCheated = true;
+	return true;
+#else
+	return false;
+#endif
+}
+
+const char *GetVrCheatName(int index)
+{
+	static char carName[64];
+	static char bikeName[64];
+	static char helicopterName[64];
+	static char airplaneName[64];
+	if(index == VR_SPECIAL_PASS_CURRENT_MISSION)
+		return "PASS CURRENT MISSION";
+	if(index == VR_SPECIAL_SPAWN_NEXT_CAR){
+		const int model = FindVrCycleCarModel(gVrCycleCarCursor, 1);
+		sprintf(carName, "SPAWN NEXT CAR  < %s >",
+			GetVrVehicleModelName(model));
+		return carName;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_MOTORCYCLE){
+		const int model =
+			gVrCycleBikeModels[gVrCycleBikeIndex %
+				ARRAY_SIZE(gVrCycleBikeModels)];
+		sprintf(bikeName, "SPAWN NEXT MOTORCYCLE  < %s >",
+			GetVrVehicleModelName(model));
+		return bikeName;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_HELICOPTER){
+		const int model = gVrCycleHelicopterModels[
+			gVrCycleHelicopterIndex %
+			ARRAY_SIZE(gVrCycleHelicopterModels)];
+		sprintf(helicopterName, "SPAWN NEXT HELICOPTER  < %s >",
+			GetVrVehicleModelName(model));
+		return helicopterName;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_AIRPLANE){
+		const int model = gVrCycleAirplaneModels[
+			gVrCycleAirplaneIndex %
+			ARRAY_SIZE(gVrCycleAirplaneModels)];
+		sprintf(airplaneName, "SPAWN NEXT AIRPLANE  < %s >",
+			GetVrVehicleModelName(model));
+		return airplaneName;
+	}
+	if(index == VR_SPECIAL_GOD_MODE)
+		return gVrGodModeEnabled ?
+			"GOD MODE - ON" : "GOD MODE - OFF";
+	if(index == VR_SPECIAL_OPEN_STORY_BRIDGES)
+		return "OPEN STORY BRIDGES";
+	if(index == VR_SPECIAL_UNLOCK_SIX_STAR_WANTED_CAP)
+		return "UNLOCK 6-STAR WANTED CAP";
+	const int legacyIndex = index-VR_SPECIAL_CHEAT_COUNT;
+	return legacyIndex >= 0 &&
+		legacyIndex < (int)ARRAY_SIZE(gVrCheatNames) ?
+		gVrCheatNames[legacyIndex] : "UNKNOWN";
+}
