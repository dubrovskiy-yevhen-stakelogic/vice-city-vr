+void
+COcclusion::CaptureContext(COcclusionContext *context)
+{
+	if(context == nil)
+		return;
+	context->numActiveOccluders = NumActiveOccluders;
+	if(NumActiveOccluders > 0)
+		memcpy(context->activeOccluders, aActiveOccluders,
+			NumActiveOccluders*sizeof(CActiveOccluder));
+	context->viewMatrix.CopyOnlyMatrix(TheCamera.m_viewMatrix);
+	context->screenWidth = SCREEN_WIDTH;
+	context->screenHeight = SCREEN_HEIGHT;
+	context->fov = CDraw::GetFOV();
+}
+
+void
+COcclusion::ApplyContext(const COcclusionContext &context)
+{
+	NumActiveOccluders = context.numActiveOccluders;
+	if(NumActiveOccluders > 0)
+		memcpy(aActiveOccluders, context.activeOccluders,
+			NumActiveOccluders*sizeof(CActiveOccluder));
+}
+
+bool CActiveOccluder::IsPointWithinOcclusionArea(float pX, float pY, float area) const {
 	for (int i = 0; i < linesCount; i++) {
 		if (!IsPointInsideLine(lines[i].origin.x, lines[i].origin.y, lines[i].direction.x, lines[i].direction.y, pX, pY, area))
 			return false;
@@ -527,4 +551,65 @@ bool CEntity::IsEntityOccluded(void) {
 	}
 
 	return false;
-}
\ No newline at end of file
+}
+
+static bool
+CalcScreenCoors(const COcclusionContext &context, CVector const &in,
+	CVector *out, float *outw, float *outh)
+{
+	*out = context.viewMatrix * in;
+	if(out->z <= 1.0f)
+		return false;
+	const float recip = 1.0f / out->z;
+	out->x *= context.screenWidth * recip;
+	out->y *= context.screenHeight * recip;
+	const float fovScale = DefaultFOV / context.fov;
+	*outw = fovScale * recip * context.screenWidth;
+	*outh = fovScale * recip * context.screenHeight;
+	return true;
+}
+
+static bool
+CalcScreenCoors(const COcclusionContext &context, CVector const &in,
+	CVector *out)
+{
+	float width, height;
+	return CalcScreenCoors(context, in, out, &width, &height);
+}
+
+bool
+CEntity::IsEntityOccluded(const COcclusionContext &context)
+{
+	CVector coors;
+	float width, height;
+	if(context.numActiveOccluders == 0 ||
+	   !CalcScreenCoors(context, GetBoundCentre(), &coors, &width, &height))
+		return false;
+
+	const float boundRadius = GetBoundRadius();
+	const float area = Max(width, height) * boundRadius * 0.9f;
+	for(int i = 0; i < context.numActiveOccluders; i++){
+		const CActiveOccluder &occluder = context.activeOccluders[i];
+		if(coors.z - boundRadius*0.85f <= occluder.radius)
+			continue;
+		if(occluder.IsPointWithinOcclusionArea(coors.x, coors.y, area))
+			return true;
+		if(!occluder.IsPointWithinOcclusionArea(coors.x, coors.y, 0.0f))
+			continue;
+
+		CVector min = m_matrix *
+			CModelInfo::GetModelInfo(GetModelIndex())->GetColModel()->boundingBox.min;
+		CVector max = m_matrix *
+			CModelInfo::GetModelInfo(GetModelIndex())->GetColModel()->boundingBox.max;
+		if(CalcScreenCoors(context, min, &coors) &&
+		   !occluder.IsPointWithinOcclusionArea(coors.x, coors.y, 0.0f)) continue;
+		if(CalcScreenCoors(context, CVector(max.x, max.y, min.z), &coors) &&
+		   !occluder.IsPointWithinOcclusionArea(coors.x, coors.y, 0.0f)) continue;
+		if(CalcScreenCoors(context, CVector(max.x, min.y, max.z), &coors) &&
+		   !occluder.IsPointWithinOcclusionArea(coors.x, coors.y, 0.0f)) continue;
+		if(CalcScreenCoors(context, CVector(min.x, max.y, max.z), &coors) &&
+		   !occluder.IsPointWithinOcclusionArea(coors.x, coors.y, 0.0f)) continue;
+		return true;
+	}
+	return false;
+}
