+			right*(halfRight*(float)corners[corner][0]) +
+			up*(halfUp*(float)corners[corner][1]) +
+			forward*(halfForward*(float)corners[corner][2]);
+		RwIm3DVertexSetPos(&vertices[vertexCount], position.x, position.y, position.z);
+		RwIm3DVertexSetRGBA(&vertices[vertexCount], red, green, blue, 255);
+		vertexCount++;
+	}
+	for(int index = 0; index < 36; index++)
+		indices[indexCount++] = (RwImVertexIndex)(base + boxIndices[index]);
+}
+
+// A small rounded, tapered capsule used only by the visible tracked hands.
+// Immediate-mode VR attachments are intentionally kept independent from the
+// weapon atomics, but the old cuboids made every joint read as a stack of
+// blocks at headset distance. Eight radial sides plus rounded end rings give
+// the wrist, palm and phalanges a continuous silhouette without introducing a
+// new asset format or changing any of the already calibrated hand transforms.
+static void
+AppendVrRoundedHandSegment(RwIm3DVertex *vertices, int &vertexCount,
+	RwImVertexIndex *indices, int &indexCount, const CVector &center,
+	const CVector &right, const CVector &up, const CVector &forward,
+	float startHalfRight, float startHalfUp, float endHalfRight,
+	float endHalfUp, float halfForward, uint8 red, uint8 green, uint8 blue)
+{
+	static const int RADIAL_SEGMENTS = 8;
+	static const int RING_COUNT = 6;
+	static const float ringPosition[RING_COUNT] = {
+		-1.00f, -0.82f, -0.48f, 0.48f, 0.82f, 1.00f
+	};
+	static const float ringRadius[RING_COUNT] = {
+		0.20f, 0.72f, 1.00f, 1.00f, 0.72f, 0.20f
+	};
+	const int base = vertexCount;
+	for(int ring = 0; ring < RING_COUNT; ring++){
+		const float along = ringPosition[ring];
+		const float blend = (along + 1.0f)*0.5f;
+		const float halfRight =
+			startHalfRight + (endHalfRight-startHalfRight)*blend;
+		const float halfUp = startHalfUp + (endHalfUp-startHalfUp)*blend;
+		for(int side = 0; side < RADIAL_SEGMENTS; side++){
+			const float angle = TWOPI*(float)side/(float)RADIAL_SEGMENTS;
+			const float radialRight = Cos(angle);
+			const float radialUp = Sin(angle);
+			const CVector position = center + forward*(halfForward*along) +
+				right*(halfRight*ringRadius[ring]*radialRight) +
+				up*(halfUp*ringRadius[ring]*radialUp);
+			// Immediate 3D hand geometry is unlit. A restrained vertex gradient
+			// supplies the form cue that a normal-lit mesh would otherwise give.
+			const float shade = clamp(0.86f + radialUp*0.11f -
+				radialRight*0.035f, 0.70f, 1.0f);
+			RwIm3DVertexSetPos(&vertices[vertexCount],
+				position.x, position.y, position.z);
+			RwIm3DVertexSetRGBA(&vertices[vertexCount],
+				(uint8)(red*shade), (uint8)(green*shade),
+				(uint8)(blue*shade), 255);
+			vertexCount++;
+		}
+	}
+	for(int ring = 0; ring < RING_COUNT-1; ring++){
+		for(int side = 0; side < RADIAL_SEGMENTS; side++){
+			const int nextSide = (side+1)%RADIAL_SEGMENTS;
+			const RwImVertexIndex a =
+				(RwImVertexIndex)(base + ring*RADIAL_SEGMENTS + side);
+			const RwImVertexIndex b =
+				(RwImVertexIndex)(base + ring*RADIAL_SEGMENTS + nextSide);
+			const RwImVertexIndex c =
+				(RwImVertexIndex)(base + (ring+1)*RADIAL_SEGMENTS + side);
+			const RwImVertexIndex d =
+				(RwImVertexIndex)(base + (ring+1)*RADIAL_SEGMENTS + nextSide);
+			indices[indexCount++] = a;
+			indices[indexCount++] = c;
+			indices[indexCount++] = b;
+			indices[indexCount++] = b;
+			indices[indexCount++] = c;
+			indices[indexCount++] = d;
+		}
+	}
+	const int startCenter = vertexCount++;
+	const CVector start = center - forward*halfForward;
+	RwIm3DVertexSetPos(&vertices[startCenter], start.x, start.y, start.z);
+	RwIm3DVertexSetRGBA(&vertices[startCenter],
+		(uint8)(red*0.82f), (uint8)(green*0.82f), (uint8)(blue*0.82f), 255);
+	const int endCenter = vertexCount++;
+	const CVector end = center + forward*halfForward;
+	RwIm3DVertexSetPos(&vertices[endCenter], end.x, end.y, end.z);
+	RwIm3DVertexSetRGBA(&vertices[endCenter], red, green, blue, 255);
+	for(int side = 0; side < RADIAL_SEGMENTS; side++){
+		const int nextSide = (side+1)%RADIAL_SEGMENTS;
+		indices[indexCount++] = (RwImVertexIndex)startCenter;
+		indices[indexCount++] = (RwImVertexIndex)(base + nextSide);
+		indices[indexCount++] = (RwImVertexIndex)(base + side);
+		indices[indexCount++] = (RwImVertexIndex)endCenter;
+		indices[indexCount++] = (RwImVertexIndex)(base +
+			(RING_COUNT-1)*RADIAL_SEGMENTS + side);
+		indices[indexCount++] = (RwImVertexIndex)(base +
+			(RING_COUNT-1)*RADIAL_SEGMENTS + nextSide);
+	}
+}
+
+static void
+AppendVrFinger(RwIm3DVertex *vertices, int &vertexCount, RwImVertexIndex *indices,
+	int &indexCount, const CVector &root, const CVector &right, const CVector &up,
+	const CVector &forward, float firstLength, float secondLength, float halfWidth,
+	float curl, uint8 red, uint8 green, uint8 blue)
+{
+	curl = clamp(curl, 0.0f, 1.0f);
+	const float firstAngle = 0.10f + curl*1.05f;
+	const float secondAngle = 0.18f + curl*2.00f;
+	const CVector firstForward = forward*Cos(firstAngle) - up*Sin(firstAngle);
+	const CVector firstUp = up*Cos(firstAngle) + forward*Sin(firstAngle);
+	AppendVrRoundedHandSegment(vertices, vertexCount, indices, indexCount,
+		root + firstForward*(firstLength*0.5f), right, firstUp, firstForward,
+		halfWidth, halfWidth*0.72f, halfWidth*0.88f, halfWidth*0.62f,
+		firstLength*0.5f, red, green, blue);
+	const CVector joint = root + firstForward*firstLength;
+	const CVector secondForward = forward*Cos(secondAngle) - up*Sin(secondAngle);
+	const CVector secondUp = up*Cos(secondAngle) + forward*Sin(secondAngle);
+	AppendVrRoundedHandSegment(vertices, vertexCount, indices, indexCount,
+		joint + secondForward*(secondLength*0.5f), right, secondUp, secondForward,
+		halfWidth*0.90f, halfWidth*0.64f,
+		halfWidth*0.66f, halfWidth*0.46f, secondLength*0.5f,
+		(uint8)Min(255, red+8), (uint8)Min(255, green+8), (uint8)Min(255, blue+8));
+}
+
+static void
+RenderVrTrackedHand(int hand)
+{
+	CMatrix matrix;
+	float grip = 0.0f, trigger = 0.0f;
+#ifdef GTA_VR_OPENXR
+	if(!OculusVR::GetTrackedVisualHandMatrix(hand, &matrix, &grip, &trigger))
+#else
+	if(!OculusVR::GetTrackedHandMatrix(hand, &matrix, &grip, &trigger))
+#endif
+		return;
+	// Twelve rounded segments: wrist, palm and two phalanges for five digits.
+	RwIm3DVertex vertices[600];
+	RwImVertexIndex indices[3456];
+	int vertexCount = 0, indexCount = 0;
+	// A Touch grip pose uses +Y for the controller's button face. Treating that
+	// axis as the palm normal makes both hands look like raised, open palms.
+	// Roll the procedural hand around the controller's forward axis: finger
+	// width follows controller-up, while each palm normal faces inward.
+	// OpenXR hand index 0/1 identifies the controller position correctly, but
+	// the model-facing sign is opposite to RenderWare's converted right axis.
+	// Swap only the anatomical handedness, never the tracked poses themselves.
+	const int modelHand = 1-hand;
+	CVector up = matrix.GetRight()*(modelHand == 0 ? 1.0f : -1.0f);
+	CVector aimOrigin, forward;
+#ifdef GTA_VR_OPENXR
+	if(!OculusVR::GetTrackedVisualHandAimRay(hand, &aimOrigin, &forward))
+#else
+	if(!OculusVR::GetTrackedHandAimRay(hand, &aimOrigin, &forward))
+#endif
+		forward = matrix.GetUp();
+	forward.Normalise();
+	// Keep the palm normal, but remove any component along the pointing axis so
+	// the hand stays orthogonal when grip-pose and aim-pose differ slightly.
+	up = up - forward*DotProduct(up, forward);
+	if(up.MagnitudeSqr() < 0.0001f)
+		up = matrix.GetRight()*(modelHand == 0 ? 1.0f : -1.0f);
+	up.Normalise();
+	CVector right = CrossProduct(up, forward);
+	right.Normalise();
+#ifdef GTA_VR_OPENXR
+	// Synthetic steering sockets still need one final anatomical LEFT parity
+	// after the common controller-to-hand decode above. Without it the car glove
+	// is upside down and the bike glove faces the rider. Correct only this visual
+	// mesh axis; tracked pose, palm normal, aim and steering remain untouched.
+	if(hand == 0 && OculusVR::IsImmersiveSteeringHandleGrabbed(hand))
+		right *= -1.0f;
+#endif
+	// The index finger and thumb must remain on the upper edge after lowering
+	// the hand from its former vertical, "raised in class" orientation.
+	// A virtual handle already supplies one coherent wrist frame, including the
+	// explicit anatomical LEFT correction above. Do not run it through the raw
+	// controller handedness heuristic a second time. Keep that legacy check only
+	// for physical controllers, whose grip and aim poses are separate spaces.
+	if(!OculusVR::IsImmersiveSteeringHandleGrabbed(hand) &&
+	   DotProduct(right, matrix.GetForward()) < 0.0f)
+		right = right * -1.0f;
+	const CVector &position = matrix.GetPosition();
+	// Prefer the authored UltimateXR mesh. Missing/corrupt external assets
+	// deliberately fall through to the procedural geometry below so VR input
+	// and weapon handling never become unusable.
+	if(VRHandModel::Render(hand, position, right, up, forward, grip, trigger))
+		return;
+	const uint8 red = 198, green = 137, blue = 96;
+	// Procedural wrist and palm fallback when the hand asset cannot be rendered.
+	AppendVrRoundedHandSegment(vertices, vertexCount, indices, indexCount,
+		position - forward*0.055f - up*0.008f, right, up, forward,
+		0.025f, 0.017f, 0.033f, 0.021f, 0.043f, 174, 111, 76);
+	AppendVrRoundedHandSegment(vertices, vertexCount, indices, indexCount,
+		position + forward*0.030f, right, up, forward,
+		0.036f, 0.021f, 0.044f, 0.024f, 0.062f, red, green, blue);
+
+	static const float sideOffsets[4] = { -0.030f, -0.010f, 0.010f, 0.030f };
+	static const float firstLengths[4] = { 0.050f, 0.058f, 0.055f, 0.045f };
+	static const float secondLengths[4] = { 0.036f, 0.043f, 0.041f, 0.033f };
+	static const float halfWidths[4] = { 0.0090f, 0.0095f, 0.0090f, 0.0080f };
+	const int indexFinger = 3;
+	const CVector fingerRoot = position + forward*0.090f - up*0.005f;
+	for(int finger = 0; finger < 4; finger++){
+		const float fingerCurl = finger == indexFinger ? trigger : grip;
+		AppendVrFinger(vertices, vertexCount, indices, indexCount,
+			fingerRoot + right*sideOffsets[finger], right, up, forward,
+			firstLengths[finger], secondLengths[finger], halfWidths[finger],
+			fingerCurl, red, green, blue);
+	}
+
+	// The thumb is mirrored per hand and closes toward the palm with the grip.
+	const float thumbSign = 1.0f;
+	CVector thumbForward = forward*0.58f + right*(0.82f*thumbSign);
+	thumbForward.Normalise();
+	CVector thumbRight = CrossProduct(up, thumbForward);
+	thumbRight.Normalise();
+	const CVector thumbRoot = position + forward*0.018f +
+		right*(0.044f*thumbSign) - up*0.006f;
+	AppendVrFinger(vertices, vertexCount, indices, indexCount,
+		thumbRoot, thumbRight, up, thumbForward,
+		0.038f, 0.030f, 0.0105f, grip*0.75f, red, green, blue);
+	if(GameRender::BeginImmediate3D(vertices, vertexCount, nil,
+		rwIM3D_VERTEXXYZ|rwIM3D_VERTEXRGBA, GameRender::IMMEDIATE3D_DRAW_VR_HAND)){
+		GameRender::SubmitImmediate3DIndexed(rwPRIMTYPETRILIST, indices, indexCount);
+		GameRender::EndImmediate3D();
+	}
+}
+
+static bool
+GetVrHandBasis(int hand, CVector &position, CVector &right, CVector &up, CVector &forward)
+{
+	CMatrix matrix;
+	if(!OculusVR::GetTrackedHandMatrix(hand, &matrix))
+		return false;
+	const int modelHand = 1-hand;
+	up = matrix.GetRight()*(modelHand == 0 ? 1.0f : -1.0f);
+	CVector aimOrigin;
+	if(!OculusVR::GetTrackedHandAimRay(hand, &aimOrigin, &forward))
+		forward = matrix.GetUp();
+	forward.Normalise();
+	up = up - forward*DotProduct(up, forward);
+	if(up.MagnitudeSqr() < 0.0001f)
+		up = matrix.GetRight()*(modelHand == 0 ? 1.0f : -1.0f);
+	up.Normalise();
+	right = CrossProduct(up, forward);
+	right.Normalise();
+	if(!OculusVR::IsImmersiveSteeringHandleGrabbed(hand) &&
+	   DotProduct(right, matrix.GetForward()) < 0.0f)
+		right = right * -1.0f;
+	position = matrix.GetPosition();
+	return true;
+}
+
+static RpAtomic *GetVrHolsterWeaponAtomic(int slot, int modelId);
+
+// GetVrHandBasis chooses the palm-up axis per hand and then reorients the
+// lateral axis to follow the grip, so one hand always ends up with a mirrored
+// basis. Mirroring reverses triangle winding, and back-face culling then keeps
+// the far side of the mesh instead of the near one, drawing the model from the
+// inside. Stock weapons are too low-poly for that to read as more than odd
+// shading; detailed replacement models look turned inside-out. Cull the opposite
+// face for those draws instead of un-mirroring the basis, which would shift
+// every saved weapon offset and rotation.
+static RwCullMode
+GetVrWeaponCullMode(const CMatrix &modelMatrix)
+{
+	const float determinant = DotProduct(modelMatrix.GetRight(),
+		CrossProduct(modelMatrix.GetForward(), modelMatrix.GetUp()));
+	return determinant < 0.0f ? rwCULLMODECULLFRONT : rwCULLMODECULLBACK;
+}
+
+static void
+RenderVrTrackedWeapon(CPed *player, int hand)
+{
+	const bool virtualDetonator = OculusVR::IsTrackedDetonatorActive(hand);
+	const int heldSlot = OculusVR::GetHeldWeaponSlot(hand);
+	if(!player || (!virtualDetonator &&
+	   (!OculusVR::ShouldUseTrackedWeapon(hand) || heldSlot < 0 ||
+	    heldSlot >= TOTAL_WEAPON_SLOTS)))
+		return;
+	const eWeaponType weaponType = virtualDetonator ? WEAPONTYPE_DETONATOR :
+		player->GetWeapon(heldSlot).m_eWeaponType;
+	CWeaponInfo *weaponInfo = CWeaponInfo::GetWeaponInfo(weaponType);
+	if(!weaponInfo)
+		return;
+	const int renderCacheSlot = virtualDetonator ? WEAPONSLOT_OTHER : heldSlot;
+	RpAtomic *atomic = GetVrHolsterWeaponAtomic(renderCacheSlot,
+		weaponInfo->m_nModelId);
+	if(!atomic)
+		return;
+	CVector position, right, up, forward;
+	if(!GetVrHandBasis(hand, position, right, up, forward))
+		return;
+
+	// Vice City weapon models are authored with their frame origin at the hand
+	// bone. Preserve that convention, replacing only the animated bone matrix
+	// with the tracked right-hand/aim basis. The tiny palm-normal offset keeps
+	// the grip centred in the procedural hand instead of resting on its surface.
+	CMatrix trackedWeapon;
+	trackedWeapon.SetUnity();
+	// The authored weapon frame faces back toward PED_HANDR. Rotate it 180
+	// degrees around the tracked palm-up axis: barrel direction and lateral axis
+	// reverse together, while the correctly calibrated top remains upright.
+	trackedWeapon.GetRight() = right * -1.0f;
+	trackedWeapon.GetForward() = forward * -1.0f;
+	trackedWeapon.GetUp() = up;
+	// Expose the two useful grip-plane axes for live calibration in the VR menu.
+	// Values are stored in centimetres there and converted to world metres here.
+	float weaponOffsetX = 0.0f, weaponOffsetY = 0.0f, weaponOffsetZ = 0.0f;
+	OculusVR::GetTrackedWeaponOffsetForType(hand, weaponType,
+		&weaponOffsetX, &weaponOffsetY, &weaponOffsetZ);
+	trackedWeapon.GetPosition() = position + right*weaponOffsetX +
+		forward*weaponOffsetY + up*weaponOffsetZ;
+	// Weapon assets use the legacy PED_HANDR bone orientation rather than the
+	// OpenXR aim basis. Keep that fixed conversion separate from live
+	// calibration. Folding all angles into SetRotate at once puts its Euler
+	// representation at a 90-degree singularity, making Y and Z appear to be
+	// the same control. Three pure matrices preserve three distinct local axes.
+	float weaponRotationX = 0.0f, weaponRotationY = 0.0f, weaponRotationZ = 0.0f;
+	OculusVR::GetTrackedWeaponRotationForType(hand, weaponType,
+		&weaponRotationX, &weaponRotationY, &weaponRotationZ);
+	CMatrix weaponBaseAdjustment;
+	weaponBaseAdjustment.SetRotate(DEGTORAD(90.0f), 0.0f, DEGTORAD(-90.0f));
+	CMatrix weaponRotationXAdjustment;
+	CMatrix weaponRotationYAdjustment;
+	CMatrix weaponRotationZAdjustment;
+	weaponRotationXAdjustment.SetRotateX(DEGTORAD(weaponRotationX));
+	weaponRotationYAdjustment.SetRotateY(DEGTORAD(weaponRotationY));
+	weaponRotationZAdjustment.SetRotateZ(DEGTORAD(weaponRotationZ));
+	trackedWeapon = trackedWeapon * weaponBaseAdjustment;
+	trackedWeapon = trackedWeapon * weaponRotationXAdjustment;
+	trackedWeapon = trackedWeapon * weaponRotationYAdjustment;
+	trackedWeapon = trackedWeapon * weaponRotationZAdjustment;
+	// The same shortest-arc world rotation is also applied to GetTrackedWeaponAim,
+	// keeping the visible barrel, laser and real bullet ray inseparable while the
+	// support controller steers a long gun.
+	if(!virtualDetonator)
+		OculusVR::ApplyTrackedWeaponTwoHandTransform(hand, weaponType,
+			&trackedWeapon);
+	// Dropped/holstered rendering appends the authored adjustment itself. Store
+	// the exact inverse-adjusted placement so releasing a calibrated weapon does
+	// not make it jump, while the dropped path still reconstructs this same final
+	// model matrix.
+	CMatrix droppedWeaponPlacement = trackedWeapon*Invert(weaponBaseAdjustment);
+	if(!virtualDetonator)
+		OculusVR::SetTrackedWeaponRenderMatrix(hand, heldSlot, weaponType,
+			&droppedWeaponPlacement, &trackedWeapon);
+
+	RwFrame *frame = RpAtomicGetFrame(atomic);
+	if(!frame)
+		return;
+	RwMatrix savedMatrix = *RwFrameGetMatrix(frame);
+	trackedWeapon.CopyToRwMatrix(RwFrameGetMatrix(frame));
+	RwFrameUpdateObjects(frame);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE,
+		(void*)GetVrWeaponCullMode(trackedWeapon));
+	GameRender::SubmitAtomic(atomic, GameRender::OBJECT_DRAW_VR_WEAPON);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLBACK);
+
+	// The atomic belongs to CPed and is reused by gameplay. Never leave the
+	// tracked transform installed after this eye's draw.
+	*RwFrameGetMatrix(frame) = savedMatrix;
+	RwFrameUpdateObjects(frame);
+
+	// Show the saved foregrip socket only while the free controller is nearby.
+	// Cyan means it can be grabbed; green confirms an active support grip. This
+	// also makes the per-weapon XYZ calibration usable without a desktop overlay.
+	CVector supportAnchor;
+	bool supportEngaged = false;
+	bool calibrationSupportPreview = false;
+#ifdef GTA_VR_OPENXR
+	calibrationSupportPreview = !virtualDetonator &&
+		OculusVR::IsTrackedWeaponCalibrationTarget(hand, weaponType);
+#endif
+	if(!virtualDetonator &&
+	   (OculusVR::AreWeaponHolsterHighlightsEnabled() ||
+	    calibrationSupportPreview) &&
+	   OculusVR::GetTrackedWeaponSupportAnchor(hand, weaponType,
+	   &supportAnchor, &supportEngaged)){
+		bool supportFromBelow = false;
+#ifdef GTA_VR_OPENXR
+		supportFromBelow =
+			OculusVR::IsTrackedWeaponSupportFromBelow(hand, weaponType);
+#endif
+		// An oriented palm-sized marker previews the selected support pose:
+		// magazine grip is vertical, while support-from-below runs along the barrel.
+		const float markerHalfLong = calibrationSupportPreview ? 0.038f : 0.022f;
+		const float markerHalfWide = calibrationSupportPreview ? 0.022f : 0.013f;
+		const float markerHalfThin = calibrationSupportPreview ? 0.010f : 0.007f;
+		RwIm3DVertex markerVertices[8];
+		RwImVertexIndex markerIndices[36];
+		int markerVertexCount = 0, markerIndexCount = 0;
+		AppendVrHandBox(markerVertices, markerVertexCount, markerIndices,
+			markerIndexCount, supportAnchor, trackedWeapon.GetRight(),
+			trackedWeapon.GetUp(), trackedWeapon.GetForward(),
+			markerHalfWide,
+			supportFromBelow ? markerHalfThin : markerHalfLong,
+			supportFromBelow ? markerHalfLong : markerHalfThin,
+			calibrationSupportPreview ? 255 : (supportEngaged ? 55 : 30),
+			calibrationSupportPreview ? 220 : (supportEngaged ? 245 : 205),
+			calibrationSupportPreview ? 35 : (supportEngaged ? 105 : 245));
+		RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+		void *depthState = calibrationSupportPreview ?
+			(void*)FALSE : (void*)TRUE;
+		RwRenderStateSet(rwRENDERSTATEZTESTENABLE, depthState);
+		RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, depthState);
+		RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)FALSE);
+		RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+		RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+		if(GameRender::BeginImmediate3D(markerVertices, markerVertexCount, nil,
+		   rwIM3D_VERTEXXYZ|rwIM3D_VERTEXRGBA,
+		   GameRender::IMMEDIATE3D_DRAW_VR_HAND)){
+			GameRender::SubmitImmediate3DIndexed(rwPRIMTYPETRILIST,
+				markerIndices, markerIndexCount);
+			GameRender::EndImmediate3D();
+		}
+		if(calibrationSupportPreview){
+			RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+			RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+		}
+	}
+}
+
+static void
+RenderVrWeaponLaser(CPed *player, int hand)
+{
+	if(!player)
+		return;
+	// The beam is a hip-fire aid only. Once the optic is at the eye, the reticle
+	// itself is authoritative and the temporary calibration beam is hidden.
+	if(OculusVR::IsTrackedScopeActiveForHand(hand))
+		return;
+	const int heldSlot = OculusVR::GetHeldWeaponSlot(hand);
+	if(heldSlot < 0 || heldSlot >= TOTAL_WEAPON_SLOTS)
+		return;
+	CWeapon *weapon = &player->GetWeapon(heldSlot);
+	#ifdef GTA_VR_OPENXR
+	if(!OculusVR::IsTrackedWeaponLaserEnabledForType(weapon->m_eWeaponType))
+		return;
+	#else
+	if(!OculusVR::IsTrackedWeaponLaserEnabled())
+		return;
+	#endif
+	if(!weapon || !OculusVR::IsPhysicalGunType(weapon->m_eWeaponType) ||
+	   weapon->m_eWeaponType == WEAPONTYPE_CAMERA ||
+	   weapon->m_eWeaponType == WEAPONTYPE_FLAMETHROWER ||
+	   weapon->m_eWeaponType == WEAPONTYPE_MINIGUN ||
+	   !OculusVR::IsTrackedWeaponHeld(hand))
+		return;
+
+	CVector source, direction;
+	if(!OculusVR::GetTrackedWeaponAim(hand, weapon->m_eWeaponType, &source, &direction))
+		return;
+	direction.Normalise();
+	CVector target = source + direction*150.0f;
+	CColPoint point;
+	CEntity *hitEntity = nil;
+	CEntity *savedIgnoreEntity = CWorld::pIgnoreEntity;
+	CEntity *attachedEntity = player->m_attachedTo;
+	const bool savedAttachedCollision =
+		attachedEntity && attachedEntity->bUsesCollision;
+	CWorld::pIgnoreEntity = player;
+	if(attachedEntity)
+		attachedEntity->bUsesCollision = false;
+	const bool hit = CWorld::ProcessLineOfSight(source, target, point, hitEntity,
+		true, true, true, true, true, false, false, false);
+	if(attachedEntity)
+		attachedEntity->bUsesCollision = savedAttachedCollision;
+	CWorld::pIgnoreEntity = savedIgnoreEntity;
+	if(hit)
+		target = point.point - direction*0.008f;
+
+	const CVector beam = target - source;
+	const float distance = beam.Magnitude();
+	if(distance < 0.01f)
+		return;
+	direction = beam/distance;
+	CVector reference(0.0f, 0.0f, 1.0f);
+	CVector right = CrossProduct(direction, reference);
+	if(right.MagnitudeSqr() < 0.0001f){
+		reference = CVector(0.0f, 1.0f, 0.0f);
+		right = CrossProduct(direction, reference);
+	}
+	right.Normalise();
+	CVector up = CrossProduct(right, direction);
+	up.Normalise();
+
+	RwIm3DVertex vertices[16];
+	RwImVertexIndex indices[72];
+	int vertexCount = 0, indexCount = 0;
+	AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+		source + direction*(distance*0.5f), right, up, direction,
+		0.0020f, 0.0020f, distance*0.5f, 255, 12, 8);
+	if(hit)
+		AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+			target, right, up, direction, 0.012f, 0.012f, 0.006f,
+			255, 52, 35);
+
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	if(GameRender::BeginImmediate3D(vertices, vertexCount, nil,
+		rwIM3D_VERTEXXYZ|rwIM3D_VERTEXRGBA, GameRender::IMMEDIATE3D_DRAW_VR_LASER)){
+		GameRender::SubmitImmediate3DIndexed(rwPRIMTYPETRILIST, indices, indexCount);
+		GameRender::EndImmediate3D();
+	}
+}
