+static float
+WrapVrVehicleCameraYaw(float yaw)
+{
+	while(yaw >= PI) yaw -= TWOPI;
+	while(yaw < -PI) yaw += TWOPI;
+	return yaw;
+}
+
+enum eVrVehicleCameraTransitionPhase
+{
+	VR_VEHICLE_CAMERA_IDLE,
+	VR_VEHICLE_CAMERA_ENTER,
+	VR_VEHICLE_CAMERA_EXIT,
+	VR_VEHICLE_CAMERA_SETTLE_ON_FOOT,
+	VR_VEHICLE_CAMERA_SETTLE_IN_VEHICLE
+};
+
+struct VrVehicleCameraTransitionState
+{
+	eVrVehicleCameraTransitionPhase phase;
+	float startBaseYaw;
+	float startPedYaw;
+	float lastOutputYaw;
+	float settleOffset;
+	bool headModeVehicleSession;
+	CPed *owner;
+
+	VrVehicleCameraTransitionState()
+	{
+		Reset();
+	}
+
+	void ResetTransition()
+	{
+		phase = VR_VEHICLE_CAMERA_IDLE;
+		startBaseYaw = 0.0f;
+		startPedYaw = 0.0f;
+		lastOutputYaw = 0.0f;
+		settleOffset = 0.0f;
+	}
+
+	void Reset()
+	{
+		ResetTransition();
+		headModeVehicleSession = false;
+		owner = nil;
+	}
+
+	void Begin(eVrVehicleCameraTransitionPhase newPhase, float baseYaw,
+		float pedYaw)
+	{
+		phase = newPhase;
+		startBaseYaw = baseYaw;
+		startPedYaw = pedYaw;
+		lastOutputYaw = baseYaw;
+		settleOffset = 0.0f;
+	}
+
+	void BeginSettle(bool inVehicle, float normalYaw)
+	{
+		phase = inVehicle ? VR_VEHICLE_CAMERA_SETTLE_IN_VEHICLE :
+			VR_VEHICLE_CAMERA_SETTLE_ON_FOOT;
+		settleOffset = WrapVrVehicleCameraYaw(lastOutputYaw-normalYaw);
+	}
+};
+
+static VrVehicleCameraTransitionState gVrVehicleCameraTransition;
+
+static void
+RenderVrStereoFrame(void)
+{
+	OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_VR_SETUP);
+	CMatrix originalCamera = TheCamera.GetMatrix();
+	CMatrix vrBaseCamera = originalCamera;
+	// Remote-control missions already hand the normal camera to the RC vehicle.
+	// Do not replace that scripted camera with Tommy's hidden head transform.
+	const bool remoteMode =
+		CWorld::Players[CWorld::PlayerInFocus].IsPlayerInRemoteMode();
+	if(OculusVR::IsFirstPersonEnabled() && !remoteMode &&
+	   !OculusVR::IsStereoCutsceneActive() && !OculusVR::IsVehicleThirdPersonActive()){
+		CPed *player = FindPlayerPed();
+		// During death/respawn the CPed pointer can outlive its RenderWare clump.
+		// Bone access in that transition dereferences the missing clump, so use
+		// the game's death camera until a living rendered player exists again.
+		if(player && player->m_rwObject && !player->DyingOrDead() && player->m_pFrames[PED_HEAD]){
+			CVehicle *viewVehicle = FindPlayerVehicle();
+			const PedState playerState = player->GetPedState();
+			const bool enteringVehicle =
+				player->m_objective == OBJECTIVE_ENTER_CAR_AS_DRIVER ||
+				player->m_objective == OBJECTIVE_ENTER_CAR_AS_PASSENGER ||
+				playerState == PED_SEEK_CAR ||
+				playerState == PED_SEEK_IN_BOAT ||
+				playerState == PED_OPEN_DOOR ||
+				playerState == PED_CARJACK ||
+				playerState == PED_ENTER_CAR ||
+				playerState == PED_STEAL_CAR;
+			const bool leavingVehicle =
+				player->m_objective == OBJECTIVE_LEAVE_CAR ||
+				player->m_objective == OBJECTIVE_LEAVE_CAR_AND_DIE ||
+				playerState == PED_EXIT_CAR ||
+				playerState == PED_DRAG_FROM_CAR;
+			CVector normalForward = viewVehicle ?
+				viewVehicle->GetForward() : player->GetForward();
+			CVector normalUp = viewVehicle ?
+				(viewVehicle->IsBike() && (OculusVR::IsVrBikeHorizonLocked() || !OculusVR::IsBikeViewFollowingTilt()) ?
+					CVector(0.0f, 0.0f, 1.0f) : viewVehicle->GetUp()) :
+				player->GetUp();
+			if(viewVehicle && viewVehicle->IsBike() && !OculusVR::IsBikeViewFollowingTilt()){
+				normalForward.z = 0.0f;
+				if(normalForward.MagnitudeSqr() < 0.0001f)
+					normalForward = player->GetForward();
+			}
+			normalUp.Normalise();
+			const bool headModeOnFoot = !viewVehicle &&
+				OculusVR::IsExperimentalHeadTurningActive();
+			if(headModeOnFoot){
+				// In HEAD mode the hidden ped turns into the commanded movement
+				// direction. Keep the VR reference frame on the gameplay camera
+				// so that body alignment does not rotate the HMD view a second time.
+				CVector cameraForward =
+					TheCamera.Cams[TheCamera.ActiveCam].Front;
+				cameraForward -= normalUp*DotProduct(cameraForward, normalUp);
+				if(cameraForward.MagnitudeSqr() > 0.000001f)
+					normalForward = cameraForward;
+			}
+
+			VrVehicleCameraTransitionState &transition =
+				gVrVehicleCameraTransition;
+			if(transition.owner != player){
+				// A new player ped cannot inherit a transition interrupted by load,
+				// death, or restart. Ordinary render gaps keep the latch persistent.
+				transition.Reset();
+				transition.owner = player;
+			}
+			if(!viewVehicle && transition.phase != VR_VEHICLE_CAMERA_EXIT &&
+			   transition.phase != VR_VEHICLE_CAMERA_SETTLE_IN_VEHICLE)
+				// Remember which on-foot movement basis owns this vehicle session;
+				// IsExperimentalHeadTurningActive deliberately becomes false in cars.
+				transition.headModeVehicleSession = headModeOnFoot;
+
+			const float normalYaw = atan2f(normalForward.y, normalForward.x);
+			const CVector pedForward = player->GetForward();
+			const float pedYaw = atan2f(pedForward.y, pedForward.x);
+			if((transition.phase == VR_VEHICLE_CAMERA_SETTLE_ON_FOOT &&
+			    !viewVehicle && enteringVehicle && headModeOnFoot) ||
+			   transition.phase == VR_VEHICLE_CAMERA_IDLE &&
+			    !viewVehicle && enteringVehicle && headModeOnFoot){
+				const float startYaw =
+					transition.phase == VR_VEHICLE_CAMERA_SETTLE_ON_FOOT ?
+					transition.lastOutputYaw : normalYaw;
+				transition.Begin(VR_VEHICLE_CAMERA_ENTER, startYaw, pedYaw);
+				transition.headModeVehicleSession = true;
+			}else if((transition.phase == VR_VEHICLE_CAMERA_SETTLE_IN_VEHICLE ||
+			           transition.phase == VR_VEHICLE_CAMERA_IDLE) &&
+			          viewVehicle && leavingVehicle &&
+			          transition.headModeVehicleSession){
+				const float startYaw =
+					transition.phase == VR_VEHICLE_CAMERA_SETTLE_IN_VEHICLE ?
+					transition.lastOutputYaw : normalYaw;
+				transition.Begin(VR_VEHICLE_CAMERA_EXIT, startYaw, pedYaw);
+			}
+
+			CVector forward = normalForward;
+			CVector up = normalUp;
+			float outputYaw = normalYaw;
+			bool overrideYaw = false;
+			switch(transition.phase){
+			case VR_VEHICLE_CAMERA_ENTER:
+				if(viewVehicle){
+					// BeginStereoFrame observes this same seated boundary and
+					// re-latches the current physical head yaw to the vehicle nose.
+					transition.ResetTransition();
+					transition.headModeVehicleSession = true;
+				}else if(enteringVehicle){
+					outputYaw = WrapVrVehicleCameraYaw(transition.startBaseYaw+
+						WrapVrVehicleCameraYaw(pedYaw-transition.startPedYaw));
+					forward = pedForward;
+					up = player->GetUp();
+					overrideYaw = true;
+					transition.lastOutputYaw = outputYaw;
+				}else{
+					// A cancelled entry never crosses FindPlayerVehicle, so OpenXR
+					// has no seat boundary on which to re-latch. Preserve the last
+					// rendered basis and settle it back to the gameplay camera.
+					outputYaw = transition.lastOutputYaw;
+					overrideYaw = true;
+					transition.BeginSettle(false, normalYaw);
+				}
+				break;
+			case VR_VEHICLE_CAMERA_EXIT:
+				if(leavingVehicle){
+					outputYaw = WrapVrVehicleCameraYaw(transition.startBaseYaw+
+						WrapVrVehicleCameraYaw(pedYaw-transition.startPedYaw));
+					forward = pedForward;
+					up = player->GetUp();
+					overrideYaw = true;
+					transition.lastOutputYaw = outputYaw;
+				}else{
+					// PedSetOutCarCB (and a blocked/cancelled exit) restores the
+					// ordinary state before render. Hold the last animated yaw for
+					// this resolution frame; the true vehicle boundary re-latches
+					// OpenXR, then the settle phase returns to the normal basis.
+					outputYaw = transition.lastOutputYaw;
+					overrideYaw = true;
+					transition.BeginSettle(viewVehicle != nil, normalYaw);
+					if(!viewVehicle)
+						transition.headModeVehicleSession = headModeOnFoot;
+				}
+				break;
+			case VR_VEHICLE_CAMERA_SETTLE_ON_FOOT:
+			case VR_VEHICLE_CAMERA_SETTLE_IN_VEHICLE:
+			{
+				const float maxStep = DEGTORAD(180.0f)*
+					CTimer::GetTimeStepInSeconds();
+				if(transition.settleOffset > maxStep)
+					transition.settleOffset -= maxStep;
+				else if(transition.settleOffset < -maxStep)
+					transition.settleOffset += maxStep;
+				else
+					transition.settleOffset = 0.0f;
+				outputYaw = WrapVrVehicleCameraYaw(normalYaw+
+					transition.settleOffset);
+				overrideYaw = true;
+				transition.lastOutputYaw = outputYaw;
+				if(transition.settleOffset == 0.0f)
+					transition.ResetTransition();
+				break;
+			}
+			default:
+				transition.lastOutputYaw = normalYaw;
+				break;
+			}
+			if(overrideYaw)
+				RotateVrVehicleCameraBasisToYaw(forward, up, outputYaw);
+			up.Normalise();
+			forward.Normalise();
+			CVector left = CrossProduct(up, forward);
+			left.Normalise();
+			up = CrossProduct(forward, left);
+			up.Normalise();
+
+			vrBaseCamera.GetRight() = left;
+			vrBaseCamera.GetForward() = forward;
+			vrBaseCamera.GetUp() = up;
+			// CPed::GetNodePosition returns the skinned bone matrix position without the
+			// world transform. CPedIK uses the component matrix used by reVC's own
+			// first-person cameras, so this is Tommy's actual head position in the world.
+			CVector headPosition(0.0f, 0.0f, 0.0f);
+			if(!OculusVR::IsHeadBobbingEnabled() && FindPlayerVehicle() == nil &&
+			   !player->bIsDucking)
+				// Keep a stable eye height while walking without changing vehicle
+				// seating, crouching, or the tracked HMD orientation. 0.59 m matches
+				// reVC's established first-person no-bob camera anchor.
+				headPosition = player->GetPosition()+up*0.59f;
+			else
+				player->m_pedIK.GetComponentPosition(headPosition, PED_HEAD);
+			vrBaseCamera.GetPosition() = headPosition + forward * 0.12f;
+		}else
+			gVrVehicleCameraTransition.Reset();
+	}else
+		gVrVehicleCameraTransition.Reset();
+	OculusVR::ApplyCutsceneCamera(&vrBaseCamera);
+	if(OculusVR::IsVehicleThirdPersonActive()){
+		CVector forward = vrBaseCamera.GetForward();
+		forward.z = 0.0f;
+		if(forward.MagnitudeSqr() > 0.0001f){
+			forward.Normalise();
+			vrBaseCamera.GetForward() = forward;
+			vrBaseCamera.GetUp() = CVector(0.0f, 0.0f, 1.0f);
+			vrBaseCamera.GetRight() = CrossProduct(vrBaseCamera.GetUp(), forward);
+		}
+	}
+	const float originalFov = CDraw::GetFOV();
+	// Stop here. BeginStereoFrame runs BeginXrFrame, which blocks in xrWaitFrame
+	// and on the swapchain image. That is the runtime pacing the application, not
+	// work this frame is doing, and it is already reported by the xr_* metrics.
+	// Leaving it inside this phase counted the same milliseconds twice and made
+	// the camera setup look like a 10ms cost.
+	OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_VR_SETUP);
+	if(!OculusVR::BeginStereoFrame(Scene.camera, vrBaseCamera)){
+		OculusVR::SetInactive();
+		return;
+	}
+	OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_VR_OVERLAYS);
+	C3dMarkers::RestoreStateForStereo();
+	OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_VR_OVERLAYS);
+
+	bool renderedBothEyes = true;
+	// GPU timing: everything from here to the end of the eye passes is scene
+	// rasterization. Reconstruction and swapchain resolve are stamped
+	// separately inside the VR layer.
+#ifdef RW_D3D12
+	rw::d3d12::beginGpuTimestamp(rw::d3d12::GPU_STAGE_SCENE);
+#endif
+	CRenderer::SetVrPerViewCulling(true);
+	#ifdef RW_D3D12
+	renderedBothEyes = RenderVrStereoFrameD3D12(originalFov);
+	#else
+	for(int eye = 0; eye < 2; eye++){
+		OculusVR::PerfBeginPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+		CMatrix eyeCamera;
+		float eyeFov = originalFov;
+		if(!OculusVR::BeginEye(Scene.camera, eye, &eyeCamera, &eyeFov)){
+			OculusVR::PerfEndPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+			renderedBothEyes = false;
+			break;
+		}
+
+		TheCamera.GetMatrix() = eyeCamera;
+		CDraw::SetFOV(eyeFov);
+		TheCamera.CalculateDerivedValues();
+		CVisibilityPlugins::SetRenderWareCamera(Scene.camera);
+		// The normal renderer only clears depth because its horizon pass covers the
+		// desktop backbuffer. VR camera textures survive across frames and the
+		// asymmetric eye resolve crops their contents, so any uncovered color would
+		// otherwise remain as visible trails while the headset turns.
+		RwCameraClear(Scene.camera, &gColourTop, CLEARMODE | rwCAMERACLEARIMAGE);
+		if(!RwCameraBeginUpdate(Scene.camera)){
+			OculusVR::PerfEndPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+			renderedBothEyes = false;
+			break;
+		}
+
+		TheCamera.m_viewMatrix.Update();
+		CRenderer::PrepareVrOcclusionForCurrentView(eye);
+		if(CWeather::LightningFlash && !CCullZones::CamNoRain()){
+			CClouds::RenderBackground(255, 255, 255, 255, 255, 255, 255);
+		}else{
+			CClouds::RenderBackground(CTimeCycle::GetSkyTopRed(), CTimeCycle::GetSkyTopGreen(),
+				CTimeCycle::GetSkyTopBlue(), CTimeCycle::GetSkyBottomRed(),
+				CTimeCycle::GetSkyBottomGreen(), CTimeCycle::GetSkyBottomBlue(), 255);
+		}
+
+		DefinedState();
+		RenderScene();
+		C3dMarkers::SetPreserveAfterRender(eye == 0);
+		// Dynamic projected shadows include the additive headlight pools. They are
+		// generated once during PreRender and must survive the left eye just like
+		// bright lights and traffic-light geometry.
+		CShadows::SetPreserveAfterRender(eye == 0);
+		// PreRender builds these transient effect lists once per game frame. Keep
+		// them after the left eye so traffic lights and shiny signs are also
+		// available to the right eye.
+		CBrightLights::SetPreserveAfterRender(eye == 0);
+		CShinyTexts::SetPreserveAfterRender(eye == 0);
+		RenderEffects();
+		RenderVrTrackedHands();
+		RwCameraEndUpdate(Scene.camera);
+		OculusVR::PerfEndPhase(eye == 0 ? OculusVR::PERF_PHASE_LEFT_EYE : OculusVR::PERF_PHASE_RIGHT_EYE);
+	}
+	#endif
+#ifdef RW_D3D12
+	rw::d3d12::endGpuTimestamp(rw::d3d12::GPU_STAGE_SCENE);
+#endif
+	OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_VR_OVERLAYS);
+	CRenderer::SetVrPerViewCulling(false);
+	C3dMarkers::FinishStereoRender();
+	CShadows::FinishStereoRender();
+	CBrightLights::FinishStereoRender();
+	CShinyTexts::FinishStereoRender();
+
+	TheCamera.GetMatrix() = originalCamera;
+	CDraw::SetFOV(originalFov);
+	TheCamera.CalculateDerivedValues();
+	OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_VR_OVERLAYS);
+
+	OculusVR::PerfBeginPhase(OculusVR::PERF_PHASE_SUBMIT);
+	#if defined(RW_D3D12) && defined(GTA_VR_OPENXR)
+	// Tracked foreground is rendered after temporal reconstruction by the
+	// OpenXR backend. Keeping the callback here also guarantees it cannot outlive
+	// the static renderer owned by this translation unit.
+	OculusVR::SetTrackedForegroundRenderCallback(
+		RenderVrTrackedForegroundCallback);
+	OculusVR::SetTrackedForegroundVisibilityCallback(
+		ShouldRenderVrTrackedForeground);
+	#endif
+	if(renderedBothEyes)
+		OculusVR::SubmitStereoFrame(Scene.camera);
+	else
+		OculusVR::CancelStereoFrame(Scene.camera);
+	OculusVR::PerfEndPhase(OculusVR::PERF_PHASE_SUBMIT);
+}
+#endif
