+bool
+CTheScripts::TrySwitchToMission(int32 mission)
+{
+	if(!bUsingAMultiScriptFile || mission < 0 ||
+	   mission >= NumberOfMissionScripts ||
+	   mission >= MAX_NUM_MISSION_SCRIPTS ||
+	   MultiScriptArray[mission] <= 0)
+		return false;
+
+	// SwitchToMission unwinds a running mission through the return address
+	// installed by its death/arrest handler.  Refuse the switch during an early
+	// cutscene/setup window where that handler (or its stack frame) does not yet
+	// exist; starting a second mission there corrupts the shared mission area.
+	for(CRunningScript *script = pActiveScripts; script;
+	    script = script->GetNext()){
+		if(!script->m_bIsActive || !script->m_bIsMissionScript)
+			continue;
+		if(!script->m_bDeatharrestEnabled || script->m_nStackPointer < 1)
+			return false;
+	}
+
+	if(NumberOfExclusiveMissionScripts > 0 && mission <= UINT16_MAX-2)
+		return false;
+
+	// Validate that the exact main.scm used to populate MultiScriptArray is
+	// still readable before the current mission is cleaned up.
+#ifdef USE_DEBUG_SCRIPT_LOADER
+	CFileMgr::ChangeDir("\\data\\");
+	int handle = CFileMgr::OpenFile(scriptfile, "rb");
+	CFileMgr::ChangeDir("\\");
+#else
+	CFileMgr::ChangeDir("\\");
+	int handle = CFileMgr::OpenFile("data\\main.scm", "rb");
+#endif
+	if(handle == 0)
+		return false;
+	uint8 missionHeader[2];
+	const bool seekFailed = CFileMgr::Seek(handle, MultiScriptArray[mission], 0);
+	const bool offsetReadable = !seekFailed &&
+		CFileMgr::Read(handle, (const char*)missionHeader,
+			sizeof(missionHeader)) == sizeof(missionHeader);
+	CFileMgr::CloseFile(handle);
+	if(!offsetReadable)
+		return false;
+
+	SwitchToMission(mission);
+	return bAlreadyRunningAMissionScript;
+}
