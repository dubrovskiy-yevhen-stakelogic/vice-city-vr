+bool GetVrWristHudPanelRect(int panel, float *left, float *top,
+	float *width, float *height)
+{
+	if(!left || !top || !width || !height || panel < 0 || panel > 3)
+		return false;
+	switch(panel){
+	case 0:
+		*left = SCREEN_SCALE_X_FIX(RADAR_LEFT)-SCREEN_SCALE_X(6.0f);
+		*top = SCREEN_SCALE_FROM_BOTTOM(RADAR_BOTTOM+RADAR_HEIGHT)-SCREEN_SCALE_Y(6.0f);
+		*width = SCREEN_SCALE_X(RADAR_WIDTH+12.0f);
+		*height = SCREEN_SCALE_Y(RADAR_HEIGHT+12.0f);
+		break;
+	case 1:
+		*left = SCREEN_SCALE_FROM_RIGHT(292.0f);
+		*top = SCREEN_SCALE_Y(30.0f);
+		*width = SCREEN_SCALE_X(196.0f);
+		*height = SCREEN_SCALE_Y(84.0f);
+		break;
+	default:
+		*left = SCREEN_SCALE_X(panel == 2 ? 8.0f : 144.0f);
+		*top = SCREEN_SCALE_Y(4.0f);
+		*width = SCREEN_SCALE_X(120.0f);
+		*height = SCREEN_SCALE_Y(40.0f);
+		break;
+	}
+	return true;
+}
+
+static void DrawWristNumber(int panel, const char *text, const CRGBA &colour)
+{
+	float left, top, width, height;
+	if(!GetVrWristHudPanelRect(panel, &left, &top, &width, &height))
+		return;
+	CFont::SetJustifyOff();
+	CFont::SetBackgroundOff();
+	CFont::SetScale(SCREEN_SCALE_X(HUD_TEXT_SCALE_X), SCREEN_SCALE_Y(HUD_TEXT_SCALE_Y));
+	CFont::SetBackGroundOnlyTextOff();
+	CFont::SetPropOff();
+	CFont::SetFontStyle(FONT_HEADING);
+	CFont::SetRightJustifyOff();
+	CFont::SetCentreOn();
+	CFont::SetCentreSize(width);
+	CFont::SetDropShadowPosition(2);
+	CFont::SetDropColor(CRGBA(0, 0, 0, 255));
+	CFont::SetColor(colour);
+	wchar wide[32];
+	AsciiToUnicode(text, wide);
+	CFont::PrintString(left+width*0.5f, top+SCREEN_SCALE_Y(4.0f), wide);
+	CFont::DrawFonts();
+	CFont::SetCentreOff();
+}
+
+void RenderVrWristHudContents(unsigned int mask)
+{
+	if(!CHud::m_Wants_To_Draw_Hud || !FrontEndMenuManager.m_PrefsShowHud ||
+	   TheCamera.m_WideScreenOn || CReplay::IsPlayingBack() || !FindPlayerPed())
+		return;
+	RwRenderStateSet(rwRENDERSTATETEXTUREADDRESS, (void*)rwTEXTUREADDRESSCLAMP);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	if((mask & 1u) && FrontEndMenuManager.m_PrefsRadarMode != 2 &&
+	   !CHud::m_HideRadar && (CHud::m_ItemToFlash != ITEM_RADAR || (CTimer::GetFrameCounter() & 8))) {
+		RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+		RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+		DrawRadarContents();
+	}
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	if(mask & 2u){
+		DrawStatusContents();
+		CFont::DrawFonts();
+	}
+	if((mask & 4u) && CHud::m_ClockState){
+		char text[24];
+		snprintf(text, sizeof(text), "%02d:%02d", CClock::GetHours(), CClock::GetMinutes());
+		DrawWristNumber(2, text, CLOCK_COLOR);
+	}
+	if(mask & 8u){
+		CWeapon *weapon = FindPlayerPed()->GetWeapon();
+		CWeaponInfo *info = weapon ? CWeaponInfo::GetWeaponInfo(weapon->m_eWeaponType) : nil;
+		if(info && info->m_nWeaponSlot > 1 && weapon->m_eWeaponType != WEAPONTYPE_DETONATOR &&
+		   !CDarkel::FrenzyOnGoing()){
+			char text[24];
+			if(info->m_nAmountofAmmunition <= 1 || info->m_nAmountofAmmunition >= 1000)
+				snprintf(text, sizeof(text), "%d", weapon->m_nAmmoTotal);
+			else{
+				const int divisor = weapon->m_eWeaponType == WEAPONTYPE_FLAMETHROWER ? 10 : 1;
+				snprintf(text, sizeof(text), "%d-%d", Min((weapon->m_nAmmoTotal-
+					weapon->m_nAmmoInClip)/divisor, 9999), weapon->m_nAmmoInClip/divisor);
+			}
+			uint8 red, green, blue;
+			OculusVR::GetWristAmmoColour(&red, &green, &blue);
+			DrawWristNumber(3, text, CRGBA(red, green, blue, 255));
+		}
+	}
+}
