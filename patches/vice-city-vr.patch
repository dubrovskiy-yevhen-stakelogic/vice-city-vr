+#ifdef GTA_VR_OCULUS
+static ModelSets::eModelCategory
+GetModelSetCategory(int modelId)
+{
+	CBaseModelInfo *model = modelId >= 0 && modelId < MODELINFOSIZE ?
+		CModelInfo::GetModelInfo(modelId) : nil;
+	if(!model)
+		return ModelSets::MODEL_CATEGORY_WORLD;
+	switch(model->GetModelType()){
+	case MITYPE_VEHICLE:
+		return ModelSets::MODEL_CATEGORY_VEHICLES;
+	case MITYPE_PED:
+		return ModelSets::MODEL_CATEGORY_PEDS;
+	case MITYPE_WEAPON:
+		return ModelSets::MODEL_CATEGORY_WEAPONS;
+	default:
+		break;
+	}
+	if(ModelSets::IsVegetationModel(model->GetModelName()))
+		return ModelSets::MODEL_CATEGORY_VEGETATION;
+	return ModelSets::MODEL_CATEGORY_WORLD;
+}
+
+static bool
+ShouldUseModelSet(int modelId, ModelSets::eModelSet modelSet)
+{
+	const ModelSets::eModelCategory category = GetModelSetCategory(modelId);
+	if(category != ModelSets::MODEL_CATEGORY_WORLD ||
+	   ModelSets::HasVegetationManifest())
+		return ModelSets::GetActiveForCategory(category) == modelSet;
+
+	// Without an explicit manifest there is no reliable way to distinguish a
+	// palm from a building among SIMPLE/TIME models.  Keep all static geometry
+	// Classic unless both switches agree on Modern; never silently violate a
+	// user's "Classic vegetation" request by guessing from the model name.
+	CBaseModelInfo *model = modelId >= 0 && modelId < MODELINFOSIZE ?
+		CModelInfo::GetModelInfo(modelId) : nil;
+	if(model && (model->GetModelType() == MITYPE_SIMPLE ||
+	   model->GetModelType() == MITYPE_TIME ||
+	   model->GetModelType() == MITYPE_CLUMP))
+		return modelSet == ModelSets::MODEL_SET_MODERN &&
+			ModelSets::GetActiveForCategory(ModelSets::MODEL_CATEGORY_WORLD) ==
+				modelSet &&
+			ModelSets::GetActiveForCategory(ModelSets::MODEL_CATEGORY_VEGETATION) ==
+				modelSet;
+	return ModelSets::GetActiveForCategory(category) == modelSet;
+}
+
+static bool
+ShouldUseTxdForSet(int txdSlot, ModelSets::eModelSet modelSet)
+{
+	bool referenced = false;
+	for(int i = 0; i < MODELINFOSIZE; i++){
+		CBaseModelInfo *model = CModelInfo::GetModelInfo(i);
+		if(!model || model->GetTxdSlot() != txdSlot)
+			continue;
+		referenced = true;
+		if(ShouldUseModelSet(i, modelSet))
+			return true;
+	}
+	// Unreferenced dictionaries are generally script/UI/world dictionaries.
+	// Treat them as World instead of silently enabling every Modern TXD.
+	return !referenced && modelSet == ModelSets::MODEL_SET_MODERN &&
+		ModelSets::GetActiveForCategory(ModelSets::MODEL_CATEGORY_WORLD) ==
+			modelSet;
+}
+
+enum eModelOverlayArchive
+{
+	MODEL_OVERLAY_NONE = 0,
+	MODEL_OVERLAY_MODERN,
+	MODEL_OVERLAY_OPTIMIZED_VEGETATION,
+	MODEL_OVERLAY_XBOX
+};
+
+static eModelOverlayArchive
+GetModelOverlayArchive(const char *path)
+{
+	if(ModelSets::IsXboxAssetPath(path))
+		return MODEL_OVERLAY_XBOX;
+	if(ModelSets::IsOptimizedVegetationAssetPath(path))
+		return MODEL_OVERLAY_OPTIMIZED_VEGETATION;
+	if(ModelSets::IsModernAssetPath(path))
+		return MODEL_OVERLAY_MODERN;
+	return MODEL_OVERLAY_NONE;
+}
+
+static bool
+ShouldUseOverlayArchiveEntry(eModelOverlayArchive archive,
+	const char *extension, int modelId)
+{
+	if(archive == MODEL_OVERLAY_XBOX){
+		if(strncasecmp(extension, "DFF", 3) == 0)
+			return ShouldUseModelSet(modelId, ModelSets::MODEL_SET_XBOX);
+		if(strncasecmp(extension, "TXD", 3) == 0)
+			return ShouldUseTxdForSet(modelId-STREAM_OFFSET_TXD,
+				ModelSets::MODEL_SET_XBOX);
+		return false;
+	}
+	if(archive == MODEL_OVERLAY_OPTIMIZED_VEGETATION){
+		if(strncasecmp(extension, "DFF", 3) == 0)
+			return GetModelSetCategory(modelId) ==
+				ModelSets::MODEL_CATEGORY_VEGETATION &&
+				ShouldUseModelSet(modelId, ModelSets::MODEL_SET_MODERN);
+		if(strncasecmp(extension, "TXD", 3) == 0)
+			return ModelSets::GetActiveForCategory(
+				ModelSets::MODEL_CATEGORY_VEGETATION) ==
+				ModelSets::MODEL_SET_MODERN;
+		return false;
+	}
+	if(strncasecmp(extension, "DFF", 3) == 0)
+		return ShouldUseModelSet(modelId, ModelSets::MODEL_SET_MODERN);
+	if(strncasecmp(extension, "TXD", 3) == 0)
+		return ShouldUseTxdForSet(modelId-STREAM_OFFSET_TXD,
+			ModelSets::MODEL_SET_MODERN);
+	if(strncasecmp(extension, "IFP", 3) == 0)
+		return ModelSets::IsCategoryModernActive(
+			ModelSets::MODEL_CATEGORY_PEDS) ||
+			ModelSets::IsCategoryModernActive(
+			ModelSets::MODEL_CATEGORY_WEAPONS);
+	// Archive collision libraries are world-space bundles, not per-model
+	// vehicle collision files.  Loose vehicle COL files are handled separately.
+	return ModelSets::IsCategoryModernActive(
+		ModelSets::MODEL_CATEGORY_WORLD);
+}
