+			CStream *stream = new CStream(request.filename, ALStreamSources[0],
+				ALStreamBuffers[0], request.sampleRate);
+			if (stream == nil || !stream->IsOpened() || !stream->Prepare(request.position))
+			{
+				delete stream;
+				stream = nil;
+			}
+			if (stream)
+				stream->SetLoopCount(request.loopCount);
+
+			CStream *stale = nil;
+			{
+				std::lock_guard<std::mutex> lock(m_mutex);
+				m_busy = false;
+				m_busyGeneration = 0;
+				if (!m_shutdown && request.generation == m_generation)
+				{
+					stale = m_completed;
+					m_completed = stream;
+					m_completedGeneration = request.generation;
+					m_completedLoopCount = request.loopCount;
+					stream = nil;
+				}
+			}
+			delete stale;
+			delete stream;
+		}
+	}
+
+public:
+	CAsyncRadioLoader() :
+		m_shutdown(false), m_hasRequest(false), m_busy(false), m_generation(0),
+		m_busyGeneration(0), m_completedGeneration(0), m_completed(nil),
+		m_completedLoopCount(1), m_pendingPosition(0)
+	{
+		memset(&m_request, 0, sizeof(m_request));
+	}
+
+	void Start()
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		if (!m_worker.joinable())
+		{
+			m_shutdown = false;
+			m_worker = std::thread(&CAsyncRadioLoader::Worker, this);
+#ifdef _WIN32
+			SetThreadPriority(m_worker.native_handle(), THREAD_PRIORITY_BELOW_NORMAL);
+#endif
+		}
+	}
+
+	void Stop()
+	{
+		CStream *completed = nil;
+		std::vector<CStream*> retired;
+		{
+			std::lock_guard<std::mutex> lock(m_mutex);
+			m_shutdown = true;
+			m_hasRequest = false;
+			++m_generation;
+			completed = m_completed;
+			m_completed = nil;
+			m_completedGeneration = 0;
+		}
+		m_wake.notify_one();
+		if (m_worker.joinable())
+			m_worker.join();
+		{
+			std::lock_guard<std::mutex> lock(m_mutex);
+			retired.swap(m_retired);
+		}
+		delete completed;
+		for (CStream *stream : retired)
+			delete stream;
+	}
+
+	// OpenAL owns the source and queue on the game/audio thread.  Detach those
+	// objects synchronously, then let the worker close mpg123/ADF and release
+	// decoder PCM without extending the current VR frame.
+	void Retire(CStream *stream)
+	{
+		if (stream == nil)
+			return;
+
+		stream->DetachFromProvider();
+		bool queued = false;
+		{
+			std::lock_guard<std::mutex> lock(m_mutex);
+			if (!m_shutdown && m_worker.joinable())
+			{
+				m_retired.push_back(stream);
+				queued = true;
+			}
+		}
+		if (queued)
+			m_wake.notify_one();
+		else
+			delete stream;
+	}
+
+	void Queue(const char *filename, uint32 position, uint32 sampleRate, int32 loopCount)
+	{
+		CStream *stale = nil;
+		{
+			std::lock_guard<std::mutex> lock(m_mutex);
+			++m_generation;
+			m_request.generation = m_generation;
+			strncpy(m_request.filename, filename, sizeof(m_request.filename)-1);
+			m_request.filename[sizeof(m_request.filename)-1] = '\0';
+			m_request.position = position;
+			m_request.sampleRate = sampleRate;
+			m_request.loopCount = loopCount;
+			m_pendingPosition = position;
+			m_hasRequest = true;
+			stale = m_completed;
+			m_completed = nil;
+			m_completedGeneration = 0;
+		}
+		Retire(stale);
+		m_wake.notify_one();
+	}
+
+	void Cancel()
+	{
+		CStream *completed = nil;
+		{
+			std::lock_guard<std::mutex> lock(m_mutex);
+			++m_generation;
+			m_hasRequest = false;
+			completed = m_completed;
+			m_completed = nil;
+			m_completedGeneration = 0;
+		}
+		Retire(completed);
+	}
+
+	bool IsPending()
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		return m_hasRequest ||
+			(m_busy && m_busyGeneration == m_generation) ||
+			(m_completed && m_completedGeneration == m_generation);
+	}
+
+	uint32 GetPendingPosition()
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		return m_pendingPosition;
+	}
+
+	CStream *TakeCompleted(int32 &loopCount)
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		if (m_completed == nil || m_completedGeneration != m_generation)
+			return nil;
+		CStream *result = m_completed;
+		m_completed = nil;
+		m_completedGeneration = 0;
+		loopCount = m_completedLoopCount;
+		return result;
+	}
+};
