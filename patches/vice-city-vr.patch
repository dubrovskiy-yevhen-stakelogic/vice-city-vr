+					*impact = shaftPoint.point;
+					*contactEntity = shaftEntity;
+					result = VR_MELEE_BLOCKED;
+				}
+			}
+		}
+	}
+	CWorld::pIgnoreEntity = savedIgnoreEntity;
+	return result;
+}
