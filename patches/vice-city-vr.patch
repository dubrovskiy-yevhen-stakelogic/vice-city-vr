+}
+
+newoption {
+	trigger     = "with-oculus-vr",
+	description = "Build the experimental Oculus PC VR output (OpenGL only)"
+}
+
+newoption {
+	trigger     = "with-openxr-vr",
+	description = "Build the OpenXR PC VR output (OpenGL or D3D12, Windows x64)"
+}
+
+newoption {
+	trigger     = "openxrsdk",
+	value       = "PATH",
+	description = "Directory of the Khronos OpenXR loader package",
