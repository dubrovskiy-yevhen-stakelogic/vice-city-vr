+
+newoption {
+	trigger     = "lto",
+	description = "Use link time optimization"
+}
+
+if(_OPTIONS["with-librw"]) then
+	Librw = "vendor/librw"
+else
+	Librw = os.getenv("LIBRW") or "vendor/librw"
+end
+
+function getsys(a)
+	if a == 'windows' then
+		return 'win'
+	end
+	return a
+end
+
+function getarch(a)
+	if a == 'x86_64' then
+		return 'amd64'
+	elseif a == 'ARM' then
+		return 'arm'
+	elseif a == 'ARM64' then
+		return 'arm64'
+	end
+	return a
+end
+
+workspace "reVC"
+	language "C++"
+	configurations { "Debug", "Release", "Vanilla" }
+	startproject "reVC"
+	location "build"
+	symbols "Full"
+	staticruntime "off"
+
+	if _OPTIONS["with-asan"] then
+		buildoptions { "-fsanitize=address -g3 -fno-omit-frame-pointer" }
