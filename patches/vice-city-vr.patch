+	// copied to the VR cinema surface.  Their animated clumps can temporarily
+	// carry bounds that do not match that camera, so the ordinary per-eye safety
+	// cull must not discard them from the mono source frame.
+	if(ent->IsObject() && ((CObject*)ent)->ObjectCreatedBy == CUTSCENE_OBJECT)
+		return true;
