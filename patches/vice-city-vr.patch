+static void
+RenderVrReloadMagazine(void)
+{
+	for(int weaponHand = 0; weaponHand < 2; weaponHand++){
+		CMatrix matrix;
+		int weaponType = WEAPONTYPE_UNARMED;
+		bool held = false;
+		if(!OculusVR::GetManualReloadMagazineMatrix(weaponHand, &matrix,
+		   &weaponType, &held))
+			continue;
+		RwIm3DVertex vertices[16];
+		RwImVertexIndex indices[72];
+		int vertexCount = 0, indexCount = 0;
+		const bool smgMagazine = weaponType == WEAPONTYPE_TEC9 ||
+			weaponType == WEAPONTYPE_UZI ||
+			weaponType == WEAPONTYPE_SILENCED_INGRAM ||
+			weaponType == WEAPONTYPE_MP5;
+		const float halfRight = smgMagazine ? 0.017f : 0.014f;
+		const float halfUp = smgMagazine ? 0.058f : 0.043f;
+		const float halfForward = smgMagazine ? 0.011f : 0.009f;
+		const uint8 body = held ? 58 : 44;
+		AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+			matrix.GetPosition(), matrix.GetRight(), matrix.GetUp(),
+			matrix.GetForward(), halfRight, halfUp, halfForward,
+			body, (uint8)(body+4), (uint8)(body+9));
+		// A brass follower/lip makes the otherwise dark procedural magazine easy
+		// to find in the empty body holster, without drawing through world depth.
+		AppendVrHandBox(vertices, vertexCount, indices, indexCount,
+			matrix.GetPosition()+matrix.GetUp()*(halfUp+0.004f),
+			matrix.GetRight(), matrix.GetUp(), matrix.GetForward(),
+			halfRight*0.92f, 0.004f, halfForward*0.92f,
+			held ? 198 : 176, held ? 158 : 137, 62);
+		RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+		RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)TRUE);
+		RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)TRUE);
+		RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)FALSE);
+		RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+		RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+		if(GameRender::BeginImmediate3D(vertices, vertexCount, nil,
+			rwIM3D_VERTEXXYZ|rwIM3D_VERTEXRGBA, GameRender::IMMEDIATE3D_DRAW_VR_HAND)){
+			GameRender::SubmitImmediate3DIndexed(rwPRIMTYPETRILIST,
+				indices, indexCount);
+			GameRender::EndImmediate3D();
+		}
+	}
+}
