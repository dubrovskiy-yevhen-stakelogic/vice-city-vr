+static void
+RenderVrCalibrationHud(void)
+{
+	char stereoText[32];
+	char directionText[32];
+
+	CSprite2d::SetRecipNearClip();
+	CSprite2d::InitPerFrame();
+	DefinedState();
+
+	const float pixel = Max(4.0f, SCREEN_HEIGHT / 280.0f);
+	const float panelTop = SCREEN_HEIGHT * 0.20f;
+	const float panelBottom = panelTop + pixel * 18.0f;
+	CSprite2d::DrawRectXLU(CRect(SCREEN_WIDTH * 0.22f, panelTop - pixel * 2.0f,
+		SCREEN_WIDTH * 0.78f, panelBottom),
+		CRGBA(0, 0, 0, 190), CRGBA(0, 0, 0, 190), CRGBA(0, 0, 0, 190), CRGBA(0, 0, 0, 190));
+
+	sprintf(stereoText, "STEREO: %d%%", OculusVR::GetStereoScalePercent());
+	sprintf(directionText, "DIR: %s", OculusVR::IsStereoReversed() ? "REVERSED" : "ORIGINAL");
+	DrawVrDebugText(stereoText, SCREEN_WIDTH * 0.5f, panelTop, pixel, CRGBA(255, 230, 64, 255));
+	DrawVrDebugText(directionText, SCREEN_WIDTH * 0.5f, panelTop + pixel * 9.0f,
+		pixel, CRGBA(96, 220, 255, 255));
+}
