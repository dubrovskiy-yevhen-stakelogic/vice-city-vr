+bool ActivateVrCheat(int index)
+{
+	if(index == VR_SPECIAL_PASS_CURRENT_MISSION)
+		return PassCurrentVrMission();
+	if(index == VR_SPECIAL_SPAWN_NEXT_CAR){
+		if(!FindPlayerPed())
+			return false;
+		const int model = FindVrCycleCarModel(gVrCycleCarCursor, 1);
+		if(model < 0)
+			return false;
+		VehicleCheat(model);
+		gVrCycleCarCursor = FindVrCycleCarModel(model+1, 1);
+		return true;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_MOTORCYCLE){
+		if(!FindPlayerPed())
+			return false;
+		const int model =
+			gVrCycleBikeModels[gVrCycleBikeIndex %
+				ARRAY_SIZE(gVrCycleBikeModels)];
+		VehicleCheat(model);
+		gVrCycleBikeIndex =
+			(gVrCycleBikeIndex+1) % ARRAY_SIZE(gVrCycleBikeModels);
+		return true;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_HELICOPTER){
+		if(!FindPlayerPed())
+			return false;
+		const int model = gVrCycleHelicopterModels[
+			gVrCycleHelicopterIndex %
+			ARRAY_SIZE(gVrCycleHelicopterModels)];
+		VehicleCheat(model);
+		gVrCycleHelicopterIndex = (gVrCycleHelicopterIndex+1) %
+			ARRAY_SIZE(gVrCycleHelicopterModels);
+		return true;
+	}
+	if(index == VR_SPECIAL_SPAWN_NEXT_AIRPLANE){
+		if(!FindPlayerPed())
+			return false;
+		const int model = gVrCycleAirplaneModels[
+			gVrCycleAirplaneIndex %
+			ARRAY_SIZE(gVrCycleAirplaneModels)];
+		VehicleCheat(model);
+		gVrCycleAirplaneIndex = (gVrCycleAirplaneIndex+1) %
+			ARRAY_SIZE(gVrCycleAirplaneModels);
+		return true;
+	}
+	if(index == VR_SPECIAL_GOD_MODE){
+		if(!FindPlayerPed())
+			return false;
+		SetVrGodMode(!gVrGodModeEnabled);
+		return true;
+	}
+	if(index == VR_SPECIAL_OPEN_STORY_BRIDGES)
+		return OpenVrStoryBridges();
+	if(index == VR_SPECIAL_UNLOCK_SIX_STAR_WANTED_CAP)
+		return UnlockVrSixStarWantedCap();
+	const int legacyIndex = index-VR_SPECIAL_CHEAT_COUNT;
+	// Weather and time-of-day effects are harmless before a player exists; all
+	// other cheats are deliberately rejected while in the front end.
+	if(!FindPlayerPed() &&
+	   !(legacyIndex >= VR_LEGACY_EXTRA_SUNNY_WEATHER &&
+	     legacyIndex <= VR_LEGACY_FAST_WEATHER))
+		return false;
+	switch(legacyIndex){
+	case VR_LEGACY_WEAPONS_SET_1: WeaponCheat1(); break;
+	case VR_LEGACY_WEAPONS_SET_2: WeaponCheat2(); break;
+	case VR_LEGACY_WEAPONS_SET_3: WeaponCheat3(); break;
+	case VR_LEGACY_RESTORE_HEALTH: HealthCheat(); break;
+	case VR_LEGACY_RESTORE_ARMOUR: ArmourCheat(); break;
+	case VR_LEGACY_ADD_MONEY: MoneyCheat(); break;
+	case VR_LEGACY_RAISE_WANTED: WantedLevelUpCheat(); break;
+	case VR_LEGACY_CLEAR_WANTED: WantedLevelDownCheat(); break;
+	case VR_LEGACY_SPAWN_RHINO: VehicleCheat(MI_RHINO); break;
+	case VR_LEGACY_SPAWN_BLOODRING_1: VehicleCheat(MI_BLOODRA); break;
+	case VR_LEGACY_SPAWN_BLOODRING_2: VehicleCheat(MI_BLOODRB); break;
+	case VR_LEGACY_SPAWN_ROMERO: VehicleCheat(MI_ROMERO); break;
+	case VR_LEGACY_SPAWN_LOVE_FIST_LIMO: VehicleCheat(MI_LOVEFIST); break;
+	case VR_LEGACY_SPAWN_TRASHMASTER: VehicleCheat(MI_TRASH); break;
+	case VR_LEGACY_SPAWN_SABRE_TURBO: VehicleCheat(MI_SABRETUR); break;
+	case VR_LEGACY_SPAWN_CADDY: VehicleCheat(MI_CADDY); break;
+	case VR_LEGACY_SPAWN_HOTRING_1: VehicleCheat(MI_HOTRINA); break;
+	case VR_LEGACY_SPAWN_HOTRING_2: VehicleCheat(MI_HOTRINB); break;
+	case VR_LEGACY_BLOW_UP_ALL_CARS: BlowUpCarsCheat(); break;
+	case VR_LEGACY_RANDOM_PLAYER_OUTFIT: ChangePlayerCheat(); break;
+	case VR_LEGACY_PLAYER_LANCE: ChangePlayerModel("igbuddy"); break;
+	case VR_LEGACY_PLAYER_CANDY: ChangePlayerModel("igcandy"); break;
+	case VR_LEGACY_PLAYER_KEN: ChangePlayerModel("igken"); break;
+	case VR_LEGACY_PLAYER_HILARY: ChangePlayerModel("ighlary"); break;
+	case VR_LEGACY_PLAYER_JEZZ: ChangePlayerModel("igjezz"); break;
+	case VR_LEGACY_PLAYER_PHIL: ChangePlayerModel("igphil"); break;
+	case VR_LEGACY_PLAYER_SONNY: ChangePlayerModel("igsonny"); break;
+	case VR_LEGACY_PLAYER_MERCEDES: ChangePlayerModel("igmerc"); break;
+	case VR_LEGACY_PLAYER_DICK: ChangePlayerModel("igdick"); break;
+	case VR_LEGACY_PLAYER_DIAZ: ChangePlayerModel("igdiaz"); break;
+	case VR_LEGACY_PLAYER_FAT: gfTommyFatness = 0.26f; break;
+	case VR_LEGACY_PLAYER_THIN: gfTommyFatness = -0.3f; break;
+	case VR_LEGACY_PEDESTRIAN_RIOT: MayhemCheat(); break;
